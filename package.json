{
  "name": "oppskills-core",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "start": "turbo start",
    "dev:ui-landing": "turbo run dev --filter=ui-landing",
    "dev:backend": "turbo run dev --filter=@oppskills/backend",
    "build:backend": "turbo run build --filter=@oppskills/backend",
    "build:ui-landing": "turbo run build --filter=ui-landing",
    "db:dev": "turbo run dev --filter=@oppskills/db",
    "db:migrate": "cd packages/database && pnpm dlx prisma migrate dev",
    "db:migrate:deploy": "cd packages/database && pnpm dlx prisma migrate deploy",
    "db:push": "cd packages/database && pnpm dlx prisma db push",
    "db:studio": "cd packages/database && pnpm dlx prisma studio",
    "db:generate": "cd packages/database && pnpm dlx prisma generate",
    "load-secrets": "echo 'loading secrets' && tsx load-secrets.mts",
    "start:backend": "turbo run start --filter=@oppskills/db --filter=@oppskills/backend",
    "start:ui-landing": "turbo run start --filter=ui-landing",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/client-sts": "^3.0.0",
    "@aws-sdk/credential-providers": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.0.0",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
