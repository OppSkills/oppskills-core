model notifications {
  id                    String             @id @default(cuid())
  userId                String             @map("user_id")
  eventId               String?            @map("event_id")
  hackathonId           String?            @map("hackathon_id")
  communityId           String?            @map("community_id")
  content               String
  scheduleType          ScheduleType       @default(IMMEDIATELY) @map("schedule_type")
  scheduledAt           DateTime?          @map("scheduled_at")
  status                NotificationStatus @default(DRAFT)
  totalRecipients       Int?               @map("total_recipients")
  processedCount        Int                @default(0) @map("processed_count")
  successCount          Int                @default(0) @map("success_count")
  failedCount           Int                @default(0) @map("failed_count")
  lastProcessedId       String?            @map("last_processed_id")
  processingBy          String?            @map("processing_by")
  processingStartedAt   DateTime?          @map("processing_started_at")
  processingHeartbeatAt DateTime?          @map("processing_heartbeat_at")
  retryCount            Int                @default(0) @map("retry_count")
  expectedFinishAt      DateTime?          @map("expected_finish_at")
  completedAt           DateTime?          @map("completed_at")
  dedupeKey             String?            @unique @map("dedupe_key")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at")
  logs                  NotificationLogs[]
  event                 EventEntity?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hackathon             HackathonEntity?   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  community             CommunityEntity?   @relation("CommunityNotifications", fields: [communityId], references: [id], onDelete: Cascade)
  user                  UserEntity         @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([hackathonId])
  @@index([communityId])
  @@index([status])
  @@index([scheduledAt])
  @@map("notifications")
  @@schema("email_notifications")
}

model NotificationLogs {
  id             String        @id @default(cuid())
  notificationId String        @map("notification_id")
  level          LogLevel
  message        String
  meta           Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  notification   notifications @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_logs")
  @@schema("email_notifications")
}

enum NotificationStatus {
  DRAFT
  QUEUED
  PROCESSING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED

  @@map("NotificationStatus")
  @@schema("email_notifications")
}

enum ScheduleType {
  IMMEDIATELY
  CUSTOM

  @@map("ScheduleType")
  @@schema("email_notifications")
}

enum LogLevel {
  INFO
  WARN
  ERROR

  @@map("LogLevel")
  @@schema("email_notifications")
}
