enum ChatConversationType {
  COMMUNITY  // Group — community-wide
  DIRECT     // 1:1 DM
  @@map("ChatConversationType")
  @@schema("chat")
}
enum ChatMemberRole {
  ORGANIZER
  ADMIN
  MEMBER
  @@map("ChatMemberRole")
  @@schema("chat")
}
enum ChatMessageType {
  TEXT
  IMAGE
  DOCUMENT
  VIDEO
  @@map("ChatMessageType")
  @@schema("chat")
}
/// A community created by an organizer
model ChatCommunityEntity {
  id          String   @id @default(cuid())
  name        String
  description String?
  avatarUrl   String?
  organizerId String   @map("organizer_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  organizer   UserEntity                    @relation(fields: [organizerId], references: [id])
  members     ChatCommunityMemberEntity[]
  conversations ChatConversationEntity[]
  @@map("community")
  @@schema("chat")
}
model ChatCommunityMemberEntity {
  id          String         @id @default(cuid())
  communityId String         @map("community_id")
  userId      String         @map("user_id")
  role        ChatMemberRole @default(MEMBER)
  joinedAt    DateTime       @default(now()) @map("joined_at")
  community   ChatCommunityEntity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        UserEntity          @relation(fields: [userId], references: [id])
  @@unique([communityId, userId])
  @@map("community_member")
  @@schema("chat")
}
model ChatConversationEntity {
  id             String                @id @default(cuid())
  communityId    String?               @map("community_id")
  type           ChatConversationType
  title          String?               // group name (optional for DMs)
  lastMessageAt  DateTime?             @map("last_message_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  community      ChatCommunityEntity?              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  participants   ChatConversationParticipantEntity[]
  messages       ChatMessageEntity[]
  @@map("conversation")
  @@schema("chat")
}
model ChatConversationParticipantEntity {
  id              String    @id @default(cuid())
  conversationId  String    @map("conversation_id")
  userId          String    @map("user_id")
  lastReadAt      DateTime? @map("last_read_at")
  joinedAt        DateTime  @default(now()) @map("joined_at")
  conversation    ChatConversationEntity @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            UserEntity             @relation(fields: [userId], references: [id])
  @@unique([conversationId, userId])
  @@map("conversation_participant")
  @@schema("chat")
}
model ChatMessageEntity {
  id                String          @id @default(cuid())
  conversationId    String          @map("conversation_id")
  senderId          String          @map("sender_id")
  encryptedContent  Bytes            // AES-256-GCM ciphertext
  nonce             Bytes            // IV/nonce
  senderPublicKey   Bytes            // Ephemeral X25519 public key
  messageType       ChatMessageType @default(TEXT)
  mediaUrl          String?          // S3 URL of encrypted media
  mediaEncryptedKey  Bytes?          // Media decryption key, encrypted with message key
  mediaMimeType     String?
  replyToId         String?         @map("reply_to_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")
  conversation      ChatConversationEntity @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            UserEntity             @relation(fields: [senderId], references: [id])
  replyTo           ChatMessageEntity?     @relation("MessageReply", fields: [replyToId], references: [id])
  readBy            ChatMessageReadEntity[]
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("message")
  @@schema("chat")
}
/// Encrypted message key, one row per recipient (E2EE group messaging)
model ChatMessageRecipientKeyEntity {
  id              String @id @default(cuid())
  messageId       String @map("message_id")
  userId          String @map("user_id")
  encryptedKey    Bytes   // AES-256 key encrypted with recipient's public key
  message         ChatMessageEntity @relation(fields: [messageId], references: [id], onDelete: Cascade)
  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_recipient_key")
  @@schema("chat")
}
/// Read receipts
model ChatMessageReadEntity {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")
  message   ChatMessageEntity @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      UserEntity        @relation(fields: [userId], references: [id])
  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@map("message_read")
  @@schema("chat")
}
/// E2EE public keys (one per user)
model ChatE2EEKeyEntity {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  publicKey Bytes     // X25519 public key (raw, 32 bytes)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      UserEntity @relation(fields: [userId], references: [id])
  @@map("e2ee_key")
  @@schema("chat")
}