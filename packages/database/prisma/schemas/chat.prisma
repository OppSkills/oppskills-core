enum ConversationType {
  DIRECT
  GROUP

  @@map("ConversationType")
  @@schema("chat")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  SYSTEM

  @@map("MessageType")
  @@schema("chat")
}

enum AttachmentKind {
  IMAGE
  VIDEO
  DOCUMENT

  @@map("AttachmentKind")
  @@schema("chat")
}

model ConversationEntity {
  id            String           @id @default(cuid())
  type          ConversationType
  name          String?
  handle        String?          @unique
  imageUrl      String?          @map("image_url")
  createdById   String           @map("created_by_id")
  lastMessageAt DateTime         @default(now()) @map("last_message_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  createdBy     UserEntity       @relation("UserCreatedConversations", fields: [createdById], references: [id], onDelete: Cascade)
  participants  ConversationParticipantEntity[]
  messages      MessageEntity[]
  directKey     ConversationDirectKeyEntity?

  @@index([lastMessageAt(sort: Desc)])
  @@index([createdById])
  @@map("conversation")
  @@schema("chat")
}

model ConversationParticipantEntity {
  id             String             @id @default(cuid())
  conversationId String             @map("conversation_id")
  userId         String             @map("user_id")
  lastReadAt     DateTime?          @map("last_read_at")
  leftAt         DateTime?          @map("left_at")
  joinedAt       DateTime           @default(now()) @map("joined_at")
  conversation   ConversationEntity @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           UserEntity         @relation("UserChatParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_participant")
  @@schema("chat")
}

model ConversationDirectKeyEntity {
  id             String             @id @default(cuid())
  userLowId      String             @map("user_low_id")
  userHighId     String             @map("user_high_id")
  conversationId String             @unique @map("conversation_id")
  conversation   ConversationEntity @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@map("conversation_direct_key")
  @@schema("chat")
}

model MessageEntity {
  id                String                    @id @default(cuid())
  conversationId    String                    @map("conversation_id")
  senderId          String                    @map("sender_id")
  type              MessageType               @default(TEXT)
  body              String?
  replyToMessageId  String?                   @map("reply_to_message_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  conversation      ConversationEntity        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            UserEntity                @relation("UserSentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo           MessageEntity?            @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies           MessageEntity[]           @relation("MessageReplies")
  attachment        MessageAttachmentEntity?
  deliveries        MessageDeliveryEntity[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("message")
  @@schema("chat")
}

model MessageAttachmentEntity {
  id              String         @id @default(cuid())
  messageId       String         @unique @map("message_id")
  fileName        String         @map("file_name")
  mimeType        String         @map("mime_type")
  sizeBytes       Int?           @map("size_bytes")
  url             String
  thumbnailUrl    String?        @map("thumbnail_url")
  durationSeconds Int?           @map("duration_seconds")
  kind            AttachmentKind
  createdAt       DateTime       @default(now()) @map("created_at")
  message         MessageEntity  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachment")
  @@schema("chat")
}

model MessageDeliveryEntity {
  id          String        @id @default(cuid())
  messageId   String        @map("message_id")
  userId      String        @map("user_id")
  deliveredAt DateTime      @default(now()) @map("delivered_at")
  message     MessageEntity @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        UserEntity    @relation("UserMessageDeliveries", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_delivery")
  @@schema("chat")
}
