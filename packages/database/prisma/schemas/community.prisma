model CommunityEntity {
  id                    String                  @id @default(cuid())
  name                  String
  handle                String                  @unique
  description           String?
  website               String?
  industry              Industry
  views                 Int                     @default(0)
  coverImage            String?                 @map("cover_image")
  avatarImage           String?                 @map("avatar_image")
  ownerId               String                  @map("owner_id")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  owner                 UserEntity              @relation("UserCommunities", fields: [ownerId], references: [id])
  meets                 CommunityMeetEntity[]
  members               CommunityMemberEntity[]
  communityTaskEntities CommunityTaskEntity[]
  posts                 CommunityPostEntity[]
  notifications         notifications[]         @relation("CommunityNotifications")

  @@unique([name, ownerId])
  @@index([ownerId])
  @@map("community")
  @@schema("community")
}

model CommunityMemberEntity {
  id                String                     @id @default(cuid())
  communityId       String                     @map("community_id")
  userId            String                     @map("user_id")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  accessControlRole CommunityAccessControlRole @default(MEMBER)
  role              String                     @default("MEMBER")
  community         CommunityEntity            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user              UserEntity                 @relation("UserCommunityMemberships", fields: [userId], references: [id], onDelete: Cascade)
  referralId        String?                    @map("referral_id")
  referral          ReferralEntity?            @relation("ReferralCommunityMembers", fields: [referralId], references: [id])

  @@unique([communityId, userId])
  @@index([userId])
  @@index([communityId])
  @@index([referralId])
  @@map("community_member")
  @@schema("community")
}

model CommunityTaskEntity {
  id                                 String                             @id @default(cuid())
  communityId                        String                             @map("community_id")
  title                              String
  description                        String?
  dueDate                            DateTime?                          @map("due_date")
  toUserId                           String                             @map("to_user_id")
  byUserId                           String                             @map("by_user_id")
  priority                           TaskPriority                       @default(MEDIUM)
  status                             TaskStatus                         @default(PENDING)
  tags                               String[]
  optForMail                         Boolean                            @default(false) @map("opt_for_mail")
  createdAt                          DateTime                           @default(now()) @map("created_at")
  updatedAt                          DateTime                           @updatedAt @map("updated_at")
  assignedBy                         UserEntity                         @relation("CommunityTaskAssignedBy", fields: [byUserId], references: [id])
  community                          CommunityEntity                    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  assignedTo                         UserEntity                         @relation("CommunityTaskAssignedTo", fields: [toUserId], references: [id])
  communityTaskThreadMessageEntities CommunityTaskThreadMessageEntity[]

  @@index([communityId])
  @@index([toUserId])
  @@index([byUserId])
  @@index([status])
  @@map("community_task")
  @@schema("community")
}

model CommunityTaskThreadMessageEntity {
  id        String                @id @default(cuid())
  taskId    String                @map("task_id")
  userId    String                @map("user_id")
  type      TaskThreadMessageType
  content   String
  fileName  String?               @map("file_name")
  fileSize  Int?                  @map("file_size")
  mimeType  String?               @map("mime_type")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  task      CommunityTaskEntity   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      UserEntity            @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("community_task_thread_message")
  @@schema("community")
}

model CommunityMeetEntity {
  id               String            @id @default(cuid())
  communityId      String?           @map("community_id")
  inviteCode       String            @unique @map("invite_code")
  kind             MeetKind
  title            String
  description      String?
  scheduledStartAt DateTime?         @map("scheduled_start_at")
  audienceScope    MeetAudienceScope @default(ALL) @map("audience_scope")
  hostUserId       String            @map("host_user_id")
  livekitRoomName  String            @unique @map("livekit_room_name")
  status           MeetStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  community        CommunityEntity?  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  host             UserEntity        @relation("CommunityMeetHost", fields: [hostUserId], references: [id])

  @@index([communityId])
  @@index([hostUserId])
  @@map("community_meet")
  @@schema("community")
}

enum Industry {
  TECHNOLOGY
  EDUCATION
  HEALTHCARE
  FINANCE
  ARTS_CULTURE
  SPORTS_FITNESS
  FOOD_BEVERAGE
  TRAVEL
  NONPROFIT
  GOVERNMENT
  RETAIL
  MEDIA_ENTERTAINMENT
  REAL_ESTATE
  OTHER

  @@map("Industry")
  @@schema("community")
}

enum CommunityAccessControlRole {
  ADMIN
  MODERATOR
  READ_ONLY
  MEMBER

  @@map("CommunityAccessControlRole")
  @@schema("community")
}

enum TaskThreadMessageType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  ALERT

  @@map("TaskThreadMessageType")
  @@schema("community")
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW

  @@map("TaskPriority")
  @@schema("community")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("TaskStatus")
  @@schema("community")
}

enum MeetKind {
  INSTANT
  OPEN_LINK
  SCHEDULED

  @@map("MeetKind")
  @@schema("community")
}

enum MeetAudienceScope {
  ALL
  MEMBER_TYPES

  @@map("MeetAudienceScope")
  @@schema("community")
}

enum MeetStatus {
  ACTIVE
  SCHEDULED
  ENDED

  @@map("MeetStatus")
  @@schema("community")
}

model CommunityPostEntity {
  id                 String              @id @default(cuid())
  communityId        String              @map("community_id")
  authorId           String              @map("author_id")
  content            String
  likeCount          Int                 @default(0) @map("like_count")
  commentCount       Int                 @default(0) @map("comment_count")
  repostCount        Int                 @default(0) @map("repost_count")
  postKind           CommunityPostKind   @default(ORIGINAL) @map("post_kind")
  repostedFromPostId String?             @map("reposted_from_post_id")
  views              Int                 @default(0)
  impressions        Int                 @default(0)
  status             CommunityPostStatus @default(PUBLISHED)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  community    CommunityEntity              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author       UserEntity                   @relation("CommunityPostAuthor", fields: [authorId], references: [id])
  images       CommunityPostImageEntity[]
  likes        CommunityPostLikeEntity[]
  comments     CommunityPostCommentEntity[]
  repostedFrom CommunityPostEntity?         @relation("PostReposts", fields: [repostedFromPostId], references: [id], onDelete: SetNull)
  reposts      CommunityPostEntity[]        @relation("PostReposts")
  repostRecord CommunityPostRepostEntity?   @relation("RepostPostRow")
  repostsOf    CommunityPostRepostEntity[]  @relation("OriginalPostReposts")

  @@index([communityId, status, postKind, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("community_post")
  @@schema("community")
}

model CommunityPostImageEntity {
  id        String @id @default(cuid())
  postId    String @map("post_id")
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  post CommunityPostEntity @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("community_post_image")
  @@schema("community")
}

model CommunityPostLikeEntity {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPostEntity @relation(fields: [postId], references: [id], onDelete: Cascade)
  user UserEntity          @relation("CommunityPostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("community_post_like")
  @@schema("community")
}

enum CommunityPostStatus {
  PUBLISHED
  DELETED

  @@map("CommunityPostStatus")
  @@schema("community")
}

enum CommunityPostKind {
  ORIGINAL
  REPOST
  QUOTE_REPOST

  @@map("CommunityPostKind")
  @@schema("community")
}

enum CommunityPostCommentStatus {
  PUBLISHED
  DELETED

  @@map("CommunityPostCommentStatus")
  @@schema("community")
}

model CommunityPostCommentEntity {
  id         String                     @id @default(cuid())
  postId     String                     @map("post_id")
  authorId   String                     @map("author_id")
  parentId   String?                    @map("parent_id")
  content    String
  likeCount  Int                        @default(0) @map("like_count")
  replyCount Int                        @default(0) @map("reply_count")
  status     CommunityPostCommentStatus @default(PUBLISHED)
  createdAt  DateTime                   @default(now()) @map("created_at")
  updatedAt  DateTime                   @updatedAt @map("updated_at")

  post    CommunityPostEntity              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  UserEntity                       @relation("CommunityPostCommentAuthor", fields: [authorId], references: [id])
  parent  CommunityPostCommentEntity?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies CommunityPostCommentEntity[]     @relation("CommentReplies")
  likes   CommunityPostCommentLikeEntity[]

  @@index([postId, parentId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([parentId, status, createdAt(sort: Asc), id(sort: Asc)])
  @@index([authorId])
  @@map("community_post_comment")
  @@schema("community")
}

model CommunityPostCommentLikeEntity {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment CommunityPostCommentEntity @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    UserEntity                 @relation("CommunityPostCommentLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("community_post_comment_like")
  @@schema("community")
}

model CommunityPostRepostEntity {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  originalPostId String   @map("original_post_id")
  repostPostId   String   @unique @map("repost_post_id")
  createdAt      DateTime @default(now()) @map("created_at")

  user         UserEntity          @relation("CommunityPostReposts", fields: [userId], references: [id], onDelete: Cascade)
  originalPost CommunityPostEntity @relation("OriginalPostReposts", fields: [originalPostId], references: [id], onDelete: Cascade)
  repostPost   CommunityPostEntity @relation("RepostPostRow", fields: [repostPostId], references: [id], onDelete: Cascade)

  @@unique([userId, originalPostId])
  @@index([originalPostId])
  @@map("community_post_repost")
  @@schema("community")
}
