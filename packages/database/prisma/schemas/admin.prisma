// PostgreSQL schema: admin
// Platform admin

model AdminEntity {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  immutable    Boolean    @default(false)
  isFirstLogin Boolean    @default(true) @map("is_first_login")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  adminLogs    AdminLog[]

  @@index([id])
  @@index([email])
  @@map("admin_entity")
  @@schema("admin")
}

model AdminLog {
  id        String      @id @default(cuid())
  adminId   String      @map("admin_id")
  action    String
  type      String
  createdAt DateTime    @default(now()) @map("created_at")
  admin     AdminEntity @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([type])
  @@index([createdAt])
  @@map("admin_log")
  @@schema("admin")
}
