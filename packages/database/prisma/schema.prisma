/// College entity for storing colleges in the system.
model CollegeEntity {
  id      String  @id
  name    String
  country String
  state   String
  city    String
  address String
  website String?
  logo    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Users who selected this college
  onboardingProfiles UserOnboardingProfileEntity[]

  @@index([name])
  @@index([city])
  @@index([state])
  @@map("college")
  @@schema("oppskills")
}

/// User onboarding profile entity (1:1 with UserEntity).
model UserOnboardingProfileEntity {
  id     String     @id @default(cuid())
  userId String     @unique @map("user_id")
  user   UserEntity @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 1: Primary Identity
  gender       Gender?
  userCategory UserCategory @default(COLLEGE_STUDENT) @map("user_category")

  // Step 2: Education/Work Details
  // School fields (for SCHOOL_STUDENT)
  schoolName    String? @map("school_name")
  schoolClass   String? @map("school_class")
  schoolAddress String? @map("school_address")

  // College fields (for COLLEGE_STUDENT, PROFESSIONAL_SCHOOL_STUDENT)
  collegeId          String?        @map("college_id")
  college            CollegeEntity? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  collegeCurrentYear String?        @map("college_current_year")
  collegePassoutYear Int?           @map("college_passout_year")
  collegeSkipped     Boolean        @default(false) @map("college_skipped")

  // Additional education details
  course               String?
  courseSpecialization String? @map("course_specialization")
  cgpa                 String?
  rollNumber           String? @map("roll_number")

  // Working professional fields
  companyName String? @map("company_name")
  jobTitle    String? @map("job_title")

  // Step 3: Location
  locationCity    String? @map("location_city")
  locationState   String? @map("location_state")
  locationCountry String? @map("location_country")

  // Step 4: Interests and Skills
  interests String[] @default([])
  skills    String[] @default([])

  // Step 5: Experience Level (optional)
  experienceLevel ExperienceLevel? @map("experience_level")

  // Step 6: Team Preference (optional)
  teamPreference TeamPreference? @map("team_preference")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_onboarding_profile")
  @@schema("oppskills")
}

// =============================================================================
// RAZORPAY PAYMENT MODELS
// =============================================================================

/// Organizer's Razorpay Route linked account for receiving payouts.
model RazorpayRouteAccountEntity {
  id                String              @id @default(cuid())
  userId            String              @unique @map("user_id")
  user              UserEntity          @relation("UserRazorpayRouteAccount", fields: [userId], references: [id], onDelete: Cascade)
  razorpayAccountId String              @unique @map("razorpay_account_id")
  routeProductId    String?             @map("route_product_id")
  status            RazorpayRouteStatus @default(CREATED)
  requirements      Json?
  resolutionUrl     String?             @map("resolution_url")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@map("razorpay_route_account")
  @@schema("oppskills")
}

/// Payment record for hackathon registration (supports PER_TEAM and PER_USER modes).
model HackathonPaymentEntity {
  id          String                @id @default(cuid())
  scope       HackathonPaymentScope
  hackathonId String                @map("hackathon_id")
  hackathon   HackathonEntity       @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  organizerId String                @map("organizer_id")
  organizer   UserEntity            @relation("HackathonPaymentOrganizer", fields: [organizerId], references: [id])
  payerUserId String                @map("payer_user_id")
  payerUser   UserEntity            @relation("HackathonPaymentPayer", fields: [payerUserId], references: [id])
  teamId      String?               @map("team_id")
  team        TeamEntity?           @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Money
  currency             String  @default("INR")
  grossAmount          Decimal @map("gross_amount") @db.Decimal(12, 2)
  platformFeeAmount    Decimal @map("platform_fee_amount") @db.Decimal(12, 2)
  organizerShareAmount Decimal @map("organizer_share_amount") @db.Decimal(12, 2)

  // Razorpay order/payment
  razorpayOrderId   String  @unique @map("razorpay_order_id")
  razorpayPaymentId String? @unique @map("razorpay_payment_id")
  razorpaySignature String? @map("razorpay_signature")

  // Razorpay transfer (Route)
  razorpayTransferId  String? @map("razorpay_transfer_id")
  transferOnHold      Boolean @default(true) @map("transfer_on_hold")
  transferOnHoldUntil Int?    @map("transfer_on_hold_until")
  transferStatus      String? @map("transfer_status")
  settlementStatus    String? @map("settlement_status")

  // Status
  orderStatus   HackathonPaymentOrderStatus @default(CREATED) @map("order_status")
  paymentStatus HackathonPaymentStatus      @default(CREATED) @map("payment_status")

  // Discount
  discountCodeId String?                      @map("discount_code_id")
  discountCode   HackathonDiscountCodeEntity? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  discountAmount Decimal?                     @map("discount_amount") @db.Decimal(12, 2)

  // Refund
  razorpayRefundId String?       @unique @map("razorpay_refund_id")
  refundStatus     RefundStatus? @map("refund_status")
  refundedAmount   Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  refundedAt       DateTime?     @map("refunded_at")

  // Timestamps
  capturedAt DateTime? @map("captured_at")
  failedAt   DateTime? @map("failed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Discount redemption link
  discountRedemption HackathonDiscountRedemptionEntity?

  // Payout items (which payouts include this payment)
  payoutItems HackathonPayoutItemEntity[]

  incompleteRegistrationReminder IncompleteRegistrationReminderLogEntity?

  @@index([hackathonId])
  @@index([organizerId])
  @@index([payerUserId])
  @@map("hackathon_payment")
  @@schema("oppskills")
}

/// Discount code for a hackathon (supports PERCENT and FIXED types).
model HackathonDiscountCodeEntity {
  id             String           @id @default(cuid())
  hackathonId    String           @map("hackathon_id")
  hackathon      HackathonEntity  @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  code           String
  type           DiscountCodeType
  value          Decimal          @db.Decimal(12, 2)
  active         Boolean          @default(true)
  maxRedemptions Int?             @map("max_redemptions")
  maxPerUser     Int              @default(1) @map("max_per_user")
  validFrom      DateTime?        @map("valid_from")
  validUntil     DateTime?        @map("valid_until")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  redemptions HackathonDiscountRedemptionEntity[]
  payments    HackathonPaymentEntity[]

  @@unique([hackathonId, code])
  @@index([hackathonId])
  @@map("hackathon_discount_code")
  @@schema("oppskills")
}

/// Tracks redemption of a discount code by a user.
model HackathonDiscountRedemptionEntity {
  id             String                      @id @default(cuid())
  discountCodeId String                      @map("discount_code_id")
  discountCode   HackathonDiscountCodeEntity @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  userId         String                      @map("user_id")
  user           UserEntity                  @relation("UserDiscountRedemptions", fields: [userId], references: [id], onDelete: Cascade)
  paymentId      String                      @unique @map("payment_id")
  payment        HackathonPaymentEntity      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  redeemedAt     DateTime                    @default(now()) @map("redeemed_at")

  @@unique([discountCodeId, userId])
  @@index([discountCodeId])
  @@index([userId])
  @@map("hackathon_discount_redemption")
  @@schema("oppskills")
}

/// Stores Razorpay webhook events for idempotency.
model RazorpayWebhookEventEntity {
  id          String    @id @default(cuid())
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@map("razorpay_webhook_event")
  @@schema("oppskills")
}

// =============================================================================
// MANUAL PAYOUT SYSTEM (No Razorpay Route)
// =============================================================================

/// Status of a manual payout to organizer.
enum PayoutStatus {
  PAID

  @@map("PayoutStatus")
  @@schema("oppskills")
}

/// Organizer's bank account details for manual payouts.
model OrganizerPayoutDetailsEntity {
  id                String     @id @default(cuid())
  userId            String     @unique @map("user_id")
  user              UserEntity @relation("UserPayoutDetails", fields: [userId], references: [id], onDelete: Cascade)
  accountHolderName String     @map("account_holder_name")
  accountNumber     String     @map("account_number")
  ifsc              String
  upiId             String?    @map("upi_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("organizer_payout_details")
  @@schema("oppskills")
}

/// Record of a manual payout to an organizer for a hackathon.
model HackathonPayoutEntity {
  id          String          @id @default(cuid())
  hackathonId String          @map("hackathon_id")
  hackathon   HackathonEntity @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  organizerId String          @map("organizer_id")
  organizer   UserEntity      @relation("UserPayoutsReceived", fields: [organizerId], references: [id])
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("INR")
  status      PayoutStatus    @default(PAID)
  eligibleAt  DateTime        @map("eligible_at")
  paidAt      DateTime        @map("paid_at")
  reference   String // UTR / bank transfer reference
  notes       String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

