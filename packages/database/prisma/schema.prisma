generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["oppskills"]
  url      = env("DATABASE_URL")
}

enum HackathonMode {
  ONLINE
  OFFLINE
  HYBRID

  @@map("HackathonMode")
  @@schema("oppskills")
}

/// Internal app authorization role for a user.
/// Default is USER.
enum AccessLevel {
  ADMIN
  USER
  VIEWER

  @@map("AccessLevel")
  @@schema("oppskills")
}

/// General lifecycle status for festivals and hackathons.
enum LifecycleStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED

  @@map("LifecycleStatus")
  @@schema("oppskills")
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNIVERSITY_ONLY

  @@map("Visibility")
  @@schema("oppskills")
}

enum HackathonType {
  CODING_HACKATHON
  IDEA_HACKATHON
  CASE_STUDY_COMPETITION
  DESIGN_HACKATHON
  OPEN_HACKATHON

  @@map("HackathonType")
  @@schema("oppskills")
}

enum ParticipantType {
  INDIVIDUAL
  TEAM_OF_2
  TEAM_OF_3
  TEAM_OF_4
  TEAM_OF_5
  TEAM_OF_6
  MORE_THAN_6
  TEAM_OF_2_3
  TEAM_OF_2_4
  TEAM_OF_3_4
  TEAM_OF_3_5
  TEAM_OF_4_5
  TEAM_OF_4_6
  TEAM_OF_5_6

  @@map("ParticipantType")
  @@schema("oppskills")
}

enum LocationType {
  PHYSICAL
  VIRTUAL

  @@map("LocationType")
  @@schema("oppskills")
}

enum RoundStatus {
  UPCOMING
  ONGOING
  COMPLETED

  @@map("RoundStatus")
  @@schema("oppskills")
}

enum RegistrationFieldType {
  TEXT
  PHONE_NO
  EMAIL
  NUMBER
  ATTACHMENTS
  OPTIONS

  @@map("RegistrationFieldType")
  @@schema("oppskills")
}

/// Who can attend the hackathon (multi-select).
enum HackathonAttendeeEligibility {
  EVERYONE_CAN_APPLY
  SCHOOL_STUDENTS
  COLLEGE_STUDENTS
  FRESHERS
  PROFESSIONALS

  @@map("HackathonAttendeeEligibility")
  @@schema("oppskills")
}

/// Type of event.
enum EventType {
  WORKSHOP
  CONFERENCE
  MEETUP
  NETWORKING
  SEMINAR
  WEBINAR
  OTHER

  @@map("EventType")
  @@schema("oppskills")
}

/// Who can attend the event (multi-select).
enum EventAttendeeEligibility {
  EVERYONE_CAN_APPLY
  SCHOOL_STUDENTS
  COLLEGE_STUDENTS
  FRESHERS
  PROFESSIONALS

  @@map("EventAttendeeEligibility")
  @@schema("oppskills")
}

/// Event pass sending mode.
enum PassSendingMode {
  IMMEDIATE
  APPROVAL

  @@map("PassSendingMode")
  @@schema("oppskills")
}

/// College matching mode for event restrictions.
enum CollegeMatchMode {
  PROFILE_ONLY
  EMAIL_ONLY
  EITHER_OR
  BOTH_REQUIRED

  @@map("CollegeMatchMode")
  @@schema("oppskills")
}

/// Type of hackathon round (determines submission requirements).
enum HackathonRoundType {
  ONLINE
  OFFLINE
  PRESENTATION

  @@map("HackathonRoundType")
  @@schema("oppskills")
}

/// Per-hackathon user roles (assigned by owner/admin).
enum HackathonUserRole {
  MANAGER
  EVALUATOR

  @@map("HackathonUserRole")
  @@schema("oppskills")
}

/// Per-event user roles (assigned by owner/admin).
enum EventUserRole {
  MANAGER
  EVALUATOR

  @@map("EventUserRole")
  @@schema("oppskills")
}

/// Gender values for onboarding profile.
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY

  @@map("Gender")
  @@schema("oppskills")
}

/// User category for onboarding profile.
enum UserCategory {
  SCHOOL_STUDENT
  COLLEGE_STUDENT
  WORKING_PROFESSIONAL
  FRESHER
  PROFESSIONAL_SCHOOL_STUDENT

  @@map("UserCategory")
  @@schema("oppskills")
}

/// Experience level for onboarding profile.
enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@map("ExperienceLevel")
  @@schema("oppskills")
}

/// Team preference for onboarding profile.
enum TeamPreference {
  LOOKING_FOR_TEAM
  HAVE_TEAM
  OPEN_TO_EITHER
  PREFER_SOLO

  @@map("TeamPreference")
  @@schema("oppskills")
}

/// Approval status for platform-wide publish approval workflow.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("ApprovalStatus")
  @@schema("oppskills")
}

// =============================================================================
// RAZORPAY PAYMENT ENUMS
// =============================================================================

/// Charge mode for paid hackathons.
enum HackathonChargeMode {
  PER_TEAM
  PER_USER

  @@map("HackathonChargeMode")
  @@schema("oppskills")
}

/// Determines who bears the Razorpay processing fee (2% + 18% GST = 2.36%).
enum FeeBearer {
  ORGANISER
  PARTICIPANT

  @@map("FeeBearer")
  @@schema("oppskills")
}

/// Status of organizer's Razorpay Route linked account.
enum RazorpayRouteStatus {
  CREATED
  UNDER_REVIEW
  NEEDS_CLARIFICATION
  ACTIVATED
  SUSPENDED

  @@map("RazorpayRouteStatus")
  @@schema("oppskills")
}

/// Scope of a hackathon payment (team-wide or per-user).
enum HackathonPaymentScope {
  TEAM
  USER

  @@map("HackathonPaymentScope")
  @@schema("oppskills")
}

/// Status of hackathon payment.
enum HackathonPaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED

  @@map("HackathonPaymentStatus")
  @@schema("oppskills")
}

/// Status of hackathon payment order.
enum HackathonPaymentOrderStatus {
  CREATED
  PAID
  FAILED

  @@map("HackathonPaymentOrderStatus")
  @@schema("oppskills")
}

/// Status of a refund.
enum RefundStatus {
  CREATED
  PROCESSED
  FAILED

  @@map("RefundStatus")
  @@schema("oppskills")
}

/// Type of discount code.
enum DiscountCodeType {
  PERCENT
  FIXED

  @@map("DiscountCodeType")
  @@schema("oppskills")
}

/// Join table for per-hackathon user roles (Manager, Evaluator).
model HackathonUserRoleEntity {
  id          String            @id @default(cuid())
  hackathonId String            @map("hackathon_id")
  hackathon   HackathonEntity   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  userId      String            @map("user_id")
  user        UserEntity        @relation("UserHackathonRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        HackathonUserRole
  createdAt   DateTime          @default(now()) @map("created_at")
  createdById String?           @map("created_by_id")
  createdBy   UserEntity?       @relation("HackathonRoleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([hackathonId, userId, role])
  @@index([hackathonId])
  @@index([userId])
  @@map("hackathon_user_role")
  @@schema("oppskills")
}

model UserEntity {
  id          String      @id @default(cuid())
  email       String      @unique
  imageUrl    String?
  firstName   String?
  lastName    String?
  accessLevel AccessLevel @default(USER) @map("access_level")
  onboarded   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  hackathons   HackathonEntity[]  @relation("UserHackathons") // created hackathons
  festivals    FestivalEntity[]   @relation("UserFestivals") // created festivals
  teamsCreated TeamEntity[]       @relation("TeamCreator") // teams this user has created
  teamsLed     TeamEntity[]       @relation("UserTeams") // teams this user is leading
  teamMembers  TeamMemberEntity[] // teams they are part of

  // Per-hackathon roles (Manager/Evaluator)
  hackathonRoles        HackathonUserRoleEntity[] @relation("UserHackathonRoles")
  hackathonRolesCreated HackathonUserRoleEntity[] @relation("HackathonRoleCreator")

  // Event relations
  events                       EventEntity[]                       @relation("UserEvents") // created events
  eventRoles                   EventUserRoleEntity[]               @relation("UserEventRoles") // event role assignments
  eventRolesCreated            EventUserRoleEntity[]               @relation("EventRoleCreator") // event roles user assigned to others
  eventParticipations          EventParticipantEntity[] // events user is participating in
  eventParticipantApprovals    EventParticipantEntity[]            @relation("EventParticipantApprover") // participants approved by this user
  eventRegistrationSubmissions EventRegistrationSubmissionEntity[] @relation("UserEventSubmissions")
  eventPasses                  EventPassEntity[]                   @relation("UserEventPasses") // event passes owned by user
  scannedEventPasses           EventPassEntity[]                   @relation("ScannedEventPasses") // passes scanned by this user

  // Hackathon registration submissions
  hackathonRegistrationSubmissions HackathonRegistrationSubmissionEntity[] @relation("UserHackathonSubmissions")

  // Onboarding profile (1:1 relation)
  onboardingProfile UserOnboardingProfileEntity?

  // Razorpay Route account for organizers
  razorpayRouteAccount RazorpayRouteAccountEntity? @relation("UserRazorpayRouteAccount")

  // Payments as organizer (receiving funds)
  paymentsAsOrganizer HackathonPaymentEntity[] @relation("HackathonPaymentOrganizer")

  // Payments as payer (user paying for registration)
  paymentsAsPayer HackathonPaymentEntity[] @relation("HackathonPaymentPayer")

  // Discount code redemptions
  discountRedemptions HackathonDiscountRedemptionEntity[] @relation("UserDiscountRedemptions")

  // Manual payout details (organizer bank account)
  payoutDetails OrganizerPayoutDetailsEntity? @relation("UserPayoutDetails")

  // Payouts received as organizer
  payoutsReceived HackathonPayoutEntity[] @relation("UserPayoutsReceived")

  // Event Payments as organizer (receiving funds)
  eventPaymentsAsOrganizer EventPaymentEntity[] @relation("EventPaymentOrganizer")

  // Event Payments as payer (user paying for registration)
  eventPaymentsAsPayer EventPaymentEntity[] @relation("EventPaymentPayer")

  // Event discount code redemptions
  eventDiscountRedemptions EventDiscountRedemptionEntity[] @relation("UserEventDiscountRedemptions")

  // Event payouts received as organizer
  eventPayoutsReceived EventPayoutEntity[] @relation("UserEventPayoutsReceived")

  // Feature waitlist
  featureWaitlist FeatureWaitlistEntity[] @relation("UserFeatureWaitlist")

  /// Escrowed registration answers for paid checkout (keyed by Razorpay order id)
  paymentRegistrationEscrows PaymentRegistrationEscrowEntity[]

  @@map("user")
  @@schema("oppskills")
}

/// Server-side escrow for registration form answers between order creation and verify/webhook.
/// Lets verify and webhook recover answers when the client omits them or never calls verify.
model PaymentRegistrationEscrowEntity {
  id              String   @id @default(cuid())
  razorpayOrderId String   @unique @map("razorpay_order_id")
  payerUserId     String   @map("payer_user_id")
  user            UserEntity @relation(fields: [payerUserId], references: [id], onDelete: Cascade)
  resourceType    String   @map("resource_type") // HACKATHON | EVENT
  hackathonId     String?  @map("hackathon_id")
  eventId         String?  @map("event_id")
  answers         Json
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([payerUserId])
  @@index([hackathonId])
  @@index([eventId])
  @@map("payment_registration_escrow")
  @@schema("oppskills")
}

model HackathonEntity {
  id          String        @id @default(cuid())
  name        String        @map("title")
  description String?       @db.Text
  startDate   DateTime
  endDate     DateTime
  mode        HackathonMode
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // ---------------------------
  // Extended Hackathon Details
  // ---------------------------
  slug            String          @unique
  festivalId      String?         @map("festival_id")
  festival        FestivalEntity? @relation(fields: [festivalId], references: [id], onDelete: SetNull)
  bannerImageUrl  String?
  visibility      Visibility      @default(PUBLIC)
  hackathonType   HackathonType   @default(CODING_HACKATHON)
  participantType ParticipantType @default(INDIVIDUAL)

  // Location (denormalized columns for easy filtering)
  locationType        LocationType? @map("location_type")
  locationAddress     String?       @map("location_address")
  locationCity        String?       @map("location_city")
  locationVirtualLink String?       @map("location_virtual_link")

  // Registration
  registrationDeadline     DateTime?               @map("registration_deadline")
  externalRegistrationLink String?                 @map("external_registration_link")
  registrationForm         RegistrationFormEntity?

  // Pricing & Prizes
  isFree                Boolean                @default(true) @map("is_free")
  entryFeeAmount        Decimal?               @map("entry_fee_amount") @db.Decimal(12, 2)
  currency              String                 @default("INR")
  chargeMode            HackathonChargeMode    @default(PER_TEAM) @map("charge_mode")
  feeBearer             FeeBearer              @default(ORGANISER) @map("fee_bearer")
  prizeTotalWorthAmount Decimal?               @map("prize_total_worth_amount") @db.Decimal(12, 2)
  prizeBreakdown        PrizeBreakdownEntity[]
  prizeDescription      Json?                  @map("prize_description")
  prizeCertificate      Boolean                @default(false) @map("prize_certificate")

  // Organizer / University Restrictions
  organizationName    String?  @map("organization_name")
  organizationLogoUrl String?  @map("organization_logo_url")
  allowedUniversities String[] @default([]) @map("allowed_universities")
  freeCollegeIds      String[] @default([]) @map("free_college_ids")

  // Eligibility & Team Settings
  attendeeEligibility HackathonAttendeeEligibility[] @default([]) @map("attendee_eligibility")
  maxTeams            Int?                           @map("max_teams")

  // Additional Contact Info
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  // Metadata
  impressions       BigInt          @default(0)
  views             BigInt          @default(0)
  registrationCount Int             @default(0) @map("registration_count")
  status            LifecycleStatus @default(DRAFT)

  // Approval workflow fields
  approvalStatus      ApprovalStatus @default(PENDING) @map("approval_status")
  approvalSubmittedAt DateTime?      @map("approval_submitted_at")
  approvalApprovedAt  DateTime?      @map("approval_approved_at")
  approvalRejectedAt  DateTime?      @map("approval_rejected_at")
  approvalNote        String?        @map("approval_note") @db.Text

  // Registration controls
  isRegistrationPaused Boolean @default(false) @map("is_registration_paused")

  // Soft delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Relation: only the creator (organizer) can edit/delete
  ownerId String
  owner   UserEntity @relation("UserHackathons", fields: [ownerId], references: [id])

  // Relation: teams participating in this hackathon
  teams TeamEntity[]

  // Relations: hackathon structure
  rounds      RoundEntity[]
  attachments HackathonAttachmentEntity[]

  // Per-hackathon user roles (Manager/Evaluator)
  userRoles HackathonUserRoleEntity[]

  // Registration submissions (for tracking participant answers)
  registrationSubmissions HackathonRegistrationSubmissionEntity[]

  // Payments for this hackathon
  payments HackathonPaymentEntity[]

  // Discount codes for this hackathon
  discountCodes HackathonDiscountCodeEntity[]

  // Manual payouts for this hackathon
  payouts HackathonPayoutEntity[]

  @@index([festivalId])
  @@map("hackathon")
  @@schema("oppskills")
}

model FestivalEntity {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  description    String? @db.Text
  posterImageUrl String? @map("poster_image_url")
  websiteUrl     String? @map("website_url")

  // Location
  locationType        LocationType? @map("location_type")
  locationAddress     String?       @map("location_address")
  locationCity        String?       @map("location_city")
  locationVirtualLink String?       @map("location_virtual_link")

  // Dates
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  // Organizer
  organizerId         String?     @map("organizer_id")
  organizer           UserEntity? @relation("UserFestivals", fields: [organizerId], references: [id], onDelete: SetNull)
  organizationName    String?     @map("organization_name")
  organizationLogoUrl String?     @map("organization_logo_url")

  // Lifecycle
  status LifecycleStatus @default(DRAFT)

  // Approval workflow fields
  approvalStatus      ApprovalStatus @default(PENDING) @map("approval_status")
  approvalSubmittedAt DateTime?      @map("approval_submitted_at")
  approvalApprovedAt  DateTime?      @map("approval_approved_at")
  approvalRejectedAt  DateTime?      @map("approval_rejected_at")
  approvalNote        String?        @map("approval_note") @db.Text

  // Soft delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  hackathons HackathonEntity[]
  events     EventEntity[]

  @@index([organizerId])
  @@map("festival")
  @@schema("oppskills")
}

/// Event entity - simpler than Hackathon, for individual user participation.
model EventEntity {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  description    String? @db.Text
  bannerImageUrl String? @map("banner_image_url")

  // Dates
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  // Festival link (optional - can be standalone)
  festivalId String?         @map("festival_id")
  festival   FestivalEntity? @relation(fields: [festivalId], references: [id], onDelete: SetNull)

  // ---------------------------
  // Extended Event Details (matching Hackathon pattern)
  // ---------------------------
  visibility Visibility @default(PUBLIC)
  eventType  EventType  @default(CONFERENCE) @map("event_type")

  // Location (reuse existing pattern)
  locationType        LocationType? @map("location_type")
  locationAddress     String?       @map("location_address")
  locationCity        String?       @map("location_city")
  locationVirtualLink String?       @map("location_virtual_link")

  // Pricing (with payment integration)
  isFree         Boolean   @default(true) @map("is_free")
  entryFeeAmount Decimal?  @map("entry_fee_amount") @db.Decimal(12, 2)
  currency       String    @default("INR")
  freeCollegeIds String[]  @default([]) @map("free_college_ids")
  feeBearer      FeeBearer @default(ORGANISER) @map("fee_bearer")

  // Capacity
  maxUsers          Int? @map("max_users")
  registrationCount Int  @default(0) @map("registration_count")

  // Registration
  registrationDeadline     DateTime?                    @map("registration_deadline")
  externalRegistrationLink String?                      @map("external_registration_link")
  registrationForm         EventRegistrationFormEntity?

  // Eligibility
  attendeeEligibility EventAttendeeEligibility[] @default([]) @map("attendee_eligibility")

  // Prizes
  prizeTotalWorthAmount Decimal?                    @map("prize_total_worth_amount") @db.Decimal(12, 2)
  prizeBreakdown        EventPrizeBreakdownEntity[]
  prizeDescription      Json?                       @map("prize_description")
  prizeCertificate      Boolean                     @default(false) @map("prize_certificate")

  // Contact Info
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  // Lifecycle
  status LifecycleStatus @default(DRAFT)

  // Approval workflow fields
  approvalStatus      ApprovalStatus @default(PENDING) @map("approval_status")
  approvalSubmittedAt DateTime?      @map("approval_submitted_at")
  approvalApprovedAt  DateTime?      @map("approval_approved_at")
  approvalRejectedAt  DateTime?      @map("approval_rejected_at")
  approvalNote        String?        @map("approval_note") @db.Text

  // Registration controls
  isRegistrationPaused Boolean @default(false) @map("is_registration_paused")

  // Event Pass Settings
  passSendingMode PassSendingMode @default(IMMEDIATE) @map("pass_sending_mode")

  // College Restriction Settings
  collegeRestrictionEnabled Boolean          @default(false) @map("college_restriction_enabled")
  allowedCollegeIds         String[]         @default([]) @map("allowed_college_ids")
  allowedEmailDomains       String[]         @default([]) @map("allowed_email_domains")
  collegeMatchMode          CollegeMatchMode @default(EITHER_OR) @map("college_match_mode")

  // Metadata
  impressions BigInt @default(0)
  views       BigInt @default(0)

  // Soft delete
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")

  // Ownership
  ownerId String     @map("owner_id")
  owner   UserEntity @relation("UserEvents", fields: [ownerId], references: [id])

  // Organizer info
  organizationName    String? @map("organization_name")
  organizationLogoUrl String? @map("organization_logo_url")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  participants            EventParticipantEntity[]
  userRoles               EventUserRoleEntity[]
  attachments             EventAttachmentEntity[]
  registrationSubmissions EventRegistrationSubmissionEntity[]
  eventPasses             EventPassEntity[]                   @relation("EventPasses")

  // Payment relations
  payments      EventPaymentEntity[]
  discountCodes EventDiscountCodeEntity[]
  payouts       EventPayoutEntity[]

  @@index([festivalId])
  @@index([ownerId])
  @@map("event")
  @@schema("oppskills")
}

/// Join table for event participants (individual user registration).
model EventParticipantEntity {
  id       String      @id @default(cuid())
  eventId  String      @map("event_id")
  event    EventEntity @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String      @map("user_id")
  user     UserEntity  @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime    @default(now()) @map("joined_at")

  // Event Pass Approval Fields
  approved        Boolean     @default(false)
  approvedAt      DateTime?   @map("approved_at")
  approvedById    String?     @map("approved_by_id")
  approvedBy      UserEntity? @relation("EventParticipantApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  passEmailSent   Boolean     @default(false) @map("pass_email_sent")
  passEmailSentAt DateTime?   @map("pass_email_sent_at")

  // Relation to submission (optional, created if answers provided)
  submission EventRegistrationSubmissionEntity?

  // Event Pass relation
  eventPass EventPassEntity?

  // Payment relation (for paid events)
  payment EventPaymentEntity?

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_participant")
  @@schema("oppskills")
}

/// Event Pass entity - QR code-based pass for event participants.
model EventPassEntity {
  id String @id @default(cuid())

  /// Display ticket ID (format: № 001429)
  ticketId String @unique @map("ticket_id")

  /// Unique secure token for QR code validation (UUID v4)
  token String @unique @default(uuid())

  /// User this pass belongs to
  userId String     @map("user_id")
  user   UserEntity @relation("UserEventPasses", fields: [userId], references: [id], onDelete: Cascade)

  /// Event this pass is for
  eventId String      @map("event_id")
  event   EventEntity @relation("EventPasses", fields: [eventId], references: [id], onDelete: Cascade)

  /// Participant record (links to EventParticipantEntity)
  participantId String                 @unique @map("participant_id")
  participant   EventParticipantEntity @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// Whether pass has been scanned/used
  isUsed Boolean @default(false) @map("is_used")

  /// When pass was scanned
  scannedAt DateTime? @map("scanned_at")

  /// Who scanned the pass (organizer/manager)
  scannedById String?     @map("scanned_by_id")
  scannedBy   UserEntity? @relation("ScannedEventPasses", fields: [scannedById], references: [id], onDelete: SetNull)

  /// Pass creation and updates
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([eventId])
  @@index([participantId])
  @@index([token])
  @@map("event_pass")
  @@schema("oppskills")
}

/// Join table for per-event user roles (Manager, Evaluator).
model EventUserRoleEntity {
  id          String        @id @default(cuid())
  eventId     String        @map("event_id")
  event       EventEntity   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String        @map("user_id")
  user        UserEntity    @relation("UserEventRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        EventUserRole
  createdAt   DateTime      @default(now()) @map("created_at")
  createdById String?       @map("created_by_id")
  createdBy   UserEntity?   @relation("EventRoleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId, role])
  @@index([eventId])
  @@index([userId])
  @@map("event_user_role")
  @@schema("oppskills")
}

model RoundEntity {
  id          String          @id @default(cuid())
  hackathonId String          @map("hackathon_id")
  hackathon   HackathonEntity @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  // Use DateTime for real scheduling; API can expose "date" + "time" if desired.
  startsAt DateTime    @map("starts_at")
  endsAt   DateTime    @map("ends_at")
  order    Int
  status   RoundStatus @default(UPCOMING)

  // Round type determines submission requirements
  roundType        HackathonRoundType @map("round_type")
  submissionConfig Json?              @map("submission_config")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamSubmissions HackathonTeamRoundSubmissionEntity[]
  qualifications  TeamRoundQualificationEntity[]

  @@unique([hackathonId, order])
  @@index([hackathonId])
  @@map("round")
  @@schema("oppskills")
}

model RegistrationFormEntity {
  id               String  @id @default(cuid())
  externalFormLink String? @map("external_form_link")

  // Hackathon registration form (optional; one per hackathon)
  hackathonId String?          @unique @map("hackathon_id")
