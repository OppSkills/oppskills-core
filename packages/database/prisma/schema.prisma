generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["oppskills"]
}

/// Join table for per-hackathon user roles (Manager, Evaluator).
model HackathonUserRoleEntity {
  id          String            @id @default(cuid())
  hackathonId String            @map("hackathon_id")
  userId      String            @map("user_id")
  role        HackathonUserRole
  createdAt   DateTime          @default(now()) @map("created_at")
  createdById String?           @map("created_by_id")
  createdBy   UserEntity?       @relation("HackathonRoleCreator", fields: [createdById], references: [id])
  hackathon   HackathonEntity   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user        UserEntity        @relation("UserHackathonRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, userId, role])
  @@index([hackathonId])
  @@index([userId])
  @@map("hackathon_user_role")
  @@schema("oppskills")
}

model UserEntity {
  id                               String                                  @id @default(cuid())
  email                            String                                  @unique
  imageUrl                         String?
  firstName                        String?
  lastName                         String?
  accessLevel                      AccessLevel                             @default(USER) @map("access_level")
  createdAt                        DateTime                                @default(now())
  updatedAt                        DateTime                                @updatedAt
  onboarded                        Boolean                                 @default(false)
  events                           EventEntity[]                           @relation("UserEvents")
  eventDiscountRedemptions         EventDiscountRedemptionEntity[]         @relation("UserEventDiscountRedemptions")
  eventParticipantApprovals        EventParticipantEntity[]                @relation("EventParticipantApprover")
  eventParticipations              EventParticipantEntity[]
  scannedEventPasses               EventPassEntity[]                       @relation("ScannedEventPasses")
  eventPasses                      EventPassEntity[]                       @relation("UserEventPasses")
  eventPaymentsAsOrganizer         EventPaymentEntity[]                    @relation("EventPaymentOrganizer")
  eventPaymentsAsPayer             EventPaymentEntity[]                    @relation("EventPaymentPayer")
  eventPayoutsReceived             EventPayoutEntity[]                     @relation("UserEventPayoutsReceived")
  eventRegistrationSubmissions     EventRegistrationSubmissionEntity[]     @relation("UserEventSubmissions")
  eventRolesCreated                EventUserRoleEntity[]                   @relation("EventRoleCreator")
  eventRoles                       EventUserRoleEntity[]                   @relation("UserEventRoles")
  featureWaitlist                  FeatureWaitlistEntity[]                 @relation("UserFeatureWaitlist")
  festivals                        FestivalEntity[]                        @relation("UserFestivals")
  hackathons                       HackathonEntity[]                       @relation("UserHackathons")
  discountRedemptions              HackathonDiscountRedemptionEntity[]     @relation("UserDiscountRedemptions")
  paymentsAsOrganizer              HackathonPaymentEntity[]                @relation("HackathonPaymentOrganizer")
  paymentsAsPayer                  HackathonPaymentEntity[]                @relation("HackathonPaymentPayer")
  payoutsReceived                  HackathonPayoutEntity[]                 @relation("UserPayoutsReceived")
  hackathonRegistrationSubmissions HackathonRegistrationSubmissionEntity[] @relation("UserHackathonSubmissions")
  hackathonRolesCreated            HackathonUserRoleEntity[]               @relation("HackathonRoleCreator")
  hackathonRoles                   HackathonUserRoleEntity[]               @relation("UserHackathonRoles")
  payoutDetails                    OrganizerPayoutDetailsEntity[]          @relation("UserPayoutDetails")
  paymentRegistrationEscrows       PaymentRegistrationEscrowEntity[]
  razorpayRouteAccount             RazorpayRouteAccountEntity?             @relation("UserRazorpayRouteAccount")
  approvedReferrals                ReferralEntity[]                        @relation("ReferralApprover")
  referralsCreated                 ReferralEntity[]                        @relation("ReferralCreator")
  referralsAssigned                ReferralEntity[]                        @relation("ReferralReferrer")
  teamsCreated                     TeamEntity[]                            @relation("TeamCreator")
  teamsLed                         TeamEntity[]                            @relation("UserTeams")
  teamMembers                      TeamMemberEntity[]
  onboardingProfile                UserOnboardingProfileEntity?
  notifications                    notifications[]                         @relation("UserNotifications")

  @@map("user")
  @@schema("oppskills")
}

/// Server-side escrow for registration form answers between order creation and verify/webhook.
/// Lets verify and webhook recover answers when the client omits them or never calls verify.
model PaymentRegistrationEscrowEntity {
  id              String     @id @default(cuid())
  razorpayOrderId String     @unique @map("razorpay_order_id")
  payerUserId     String     @map("payer_user_id")
  resourceType    String     @map("resource_type")
  hackathonId     String?    @map("hackathon_id")
  eventId         String?    @map("event_id")
  answers         Json
  expiresAt       DateTime   @map("expires_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  user            UserEntity @relation(fields: [payerUserId], references: [id], onDelete: Cascade)

  @@index([payerUserId])
  @@index([hackathonId])
  @@index([eventId])
  @@map("payment_registration_escrow")
  @@schema("oppskills")
}

model HackathonEntity {
  id                       String                                  @id @default(cuid())
  name                     String                                  @map("title")
  description              String?
  startDate                DateTime
  endDate                  DateTime
  mode                     HackathonMode
  createdAt                DateTime                                @default(now())
  updatedAt                DateTime                                @updatedAt
  slug                     String                                  @unique
  festivalId               String?                                 @map("festival_id")
  bannerImageUrl           String?
  visibility               Visibility                              @default(PUBLIC)
  hackathonType            HackathonType                           @default(CODING_HACKATHON)
  participantType          ParticipantType                         @default(INDIVIDUAL)
  locationType             LocationType?                           @map("location_type")
  locationAddress          String?                                 @map("location_address")
  locationCity             String?                                 @map("location_city")
  locationVirtualLink      String?                                 @map("location_virtual_link")
  registrationDeadline     DateTime?                               @map("registration_deadline")
  externalRegistrationLink String?                                 @map("external_registration_link")
  isFree                   Boolean                                 @default(true) @map("is_free")
  entryFeeAmount           Decimal?                                @map("entry_fee_amount") @db.Decimal(12, 2)
  currency                 String                                  @default("INR")
  prizeTotalWorthAmount    Decimal?                                @map("prize_total_worth_amount") @db.Decimal(12, 2)
  prizeDescription         Json?                                   @map("prize_description")
  prizeCertificate         Boolean                                 @default(false) @map("prize_certificate")
  organizationName         String?                                 @map("organization_name")
  organizationLogoUrl      String?                                 @map("organization_logo_url")
  allowedUniversities      String[]                                @default([]) @map("allowed_universities")
  attendeeEligibility      HackathonAttendeeEligibility[]          @default([]) @map("attendee_eligibility")
  maxTeams                 Int?                                    @map("max_teams")
  contactName              String?                                 @map("contact_name")
  contactEmail             String?                                 @map("contact_email")
  contactPhone             String?                                 @map("contact_phone")
  impressions              BigInt                                  @default(0)
  registrationCount        Int                                     @default(0) @map("registration_count")
  status                   LifecycleStatus                         @default(DRAFT)
  ownerId                  String
  approvalApprovedAt       DateTime?                               @map("approval_approved_at")
  approvalNote             String?                                 @map("approval_note")
  approvalRejectedAt       DateTime?                               @map("approval_rejected_at")
  approvalStatus           ApprovalStatus                          @default(PENDING) @map("approval_status")
  approvalSubmittedAt      DateTime?                               @map("approval_submitted_at")
  isRegistrationPaused     Boolean                                 @default(false) @map("is_registration_paused")
  chargeMode               HackathonChargeMode                     @default(PER_TEAM) @map("charge_mode")
  freeCollegeIds           String[]                                @default([]) @map("free_college_ids")
  views                    BigInt                                  @default(0)
  deletedAt                DateTime?                               @map("deleted_at")
  isDeleted                Boolean                                 @default(false) @map("is_deleted")
  feeBearer                FeeBearer                               @default(ORGANISER) @map("fee_bearer")
  festival                 FestivalEntity?                         @relation(fields: [festivalId], references: [id])
  owner                    UserEntity                              @relation("UserHackathons", fields: [ownerId], references: [id])
  attachments              HackathonAttachmentEntity[]
  discountCodes            HackathonDiscountCodeEntity[]
  payments                 HackathonPaymentEntity[]
  payouts                  HackathonPayoutEntity[]
  registrationSubmissions  HackathonRegistrationSubmissionEntity[]
  userRoles                HackathonUserRoleEntity[]
  prizeBreakdown           PrizeBreakdownEntity[]
  registrationForm         RegistrationFormEntity?
  rounds                   RoundEntity[]
  teams                    TeamEntity[]
  payoutDetails            OrganizerPayoutDetailsEntity?
  notifications            notifications[]
  ticketTiers              TicketTierEntity[]

  @@index([festivalId])
  @@map("hackathon")
  @@schema("oppskills")
}

model FestivalEntity {
  id                  String            @id @default(cuid())
  slug                String            @unique
  name                String
  description         String?
  posterImageUrl      String?           @map("poster_image_url")
  websiteUrl          String?           @map("website_url")
  locationType        LocationType?     @map("location_type")
  locationAddress     String?           @map("location_address")
  locationCity        String?           @map("location_city")
  locationVirtualLink String?           @map("location_virtual_link")
  startDate           DateTime          @map("start_date")
  endDate             DateTime          @map("end_date")
  organizerId         String?           @map("organizer_id")
  organizationName    String?           @map("organization_name")
  organizationLogoUrl String?           @map("organization_logo_url")
  status              LifecycleStatus   @default(DRAFT)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  approvalApprovedAt  DateTime?         @map("approval_approved_at")
  approvalNote        String?           @map("approval_note")
  approvalRejectedAt  DateTime?         @map("approval_rejected_at")
  approvalStatus      ApprovalStatus    @default(PENDING) @map("approval_status")
  approvalSubmittedAt DateTime?         @map("approval_submitted_at")
  deletedAt           DateTime?         @map("deleted_at")
  isDeleted           Boolean           @default(false) @map("is_deleted")
  events              EventEntity[]
  organizer           UserEntity?       @relation("UserFestivals", fields: [organizerId], references: [id])
  hackathons          HackathonEntity[]

  @@index([organizerId])
  @@map("festival")
  @@schema("oppskills")
}

/// Event entity - simpler than Hackathon, for individual user participation.
model EventEntity {
  id                        String                              @id @default(cuid())
  slug                      String                              @unique
  name                      String
  description               String?
  bannerImageUrl            String?                             @map("banner_image_url")
  startDate                 DateTime                            @map("start_date")
  endDate                   DateTime                            @map("end_date")
  festivalId                String?                             @map("festival_id")
  locationType              LocationType?                       @map("location_type")
  locationAddress           String?                             @map("location_address")
  locationCity              String?                             @map("location_city")
  locationVirtualLink       String?                             @map("location_virtual_link")
  isFree                    Boolean                             @default(true) @map("is_free")
  entryFeeAmount            Decimal?                            @map("entry_fee_amount") @db.Decimal(12, 2)
  currency                  String                              @default("INR")
  maxUsers                  Int?                                @map("max_users")
  registrationCount         Int                                 @default(0) @map("registration_count")
  registrationDeadline      DateTime?                           @map("registration_deadline")
  status                    LifecycleStatus                     @default(DRAFT)
  ownerId                   String                              @map("owner_id")
  organizationName          String?                             @map("organization_name")
  organizationLogoUrl       String?                             @map("organization_logo_url")
  createdAt                 DateTime                            @default(now())
  updatedAt                 DateTime                            @updatedAt
  attendeeEligibility       EventAttendeeEligibility[]          @default([]) @map("attendee_eligibility")
  contactEmail              String?                             @map("contact_email")
  contactName               String?                             @map("contact_name")
  contactPhone              String?                             @map("contact_phone")
  eventType                 EventType                           @default(CONFERENCE) @map("event_type")
  externalRegistrationLink  String?                             @map("external_registration_link")
  impressions               BigInt                              @default(0)
  prizeCertificate          Boolean                             @default(false) @map("prize_certificate")
  prizeDescription          Json?                               @map("prize_description")
  prizeTotalWorthAmount     Decimal?                            @map("prize_total_worth_amount") @db.Decimal(12, 2)
  visibility                Visibility                          @default(PUBLIC)
  approvalApprovedAt        DateTime?                           @map("approval_approved_at")
  approvalNote              String?                             @map("approval_note")
  approvalRejectedAt        DateTime?                           @map("approval_rejected_at")
  approvalStatus            ApprovalStatus                      @default(PENDING) @map("approval_status")
  approvalSubmittedAt       DateTime?                           @map("approval_submitted_at")
  isRegistrationPaused      Boolean                             @default(false) @map("is_registration_paused")
  views                     BigInt                              @default(0)
  allowedCollegeIds         String[]                            @default([]) @map("allowed_college_ids")
  allowedEmailDomains       String[]                            @default([]) @map("allowed_email_domains")
  collegeMatchMode          CollegeMatchMode                    @default(EITHER_OR) @map("college_match_mode")
  collegeRestrictionEnabled Boolean                             @default(false) @map("college_restriction_enabled")
  passSendingMode           PassSendingMode                     @default(IMMEDIATE) @map("pass_sending_mode")
  freeCollegeIds            String[]                            @default([]) @map("free_college_ids")
  deletedAt                 DateTime?                           @map("deleted_at")
  isDeleted                 Boolean                             @default(false) @map("is_deleted")
  feeBearer                 FeeBearer                           @default(ORGANISER) @map("fee_bearer")
  festival                  FestivalEntity?                     @relation(fields: [festivalId], references: [id])
  owner                     UserEntity                          @relation("UserEvents", fields: [ownerId], references: [id])
  attachments               EventAttachmentEntity[]
  discountCodes             EventDiscountCodeEntity[]
  participants              EventParticipantEntity[]
  eventPasses               EventPassEntity[]                   @relation("EventPasses")
  payments                  EventPaymentEntity[]
  payouts                   EventPayoutEntity[]
  prizeBreakdown            EventPrizeBreakdownEntity[]
  registrationForm          EventRegistrationFormEntity?
  registrationSubmissions   EventRegistrationSubmissionEntity[]
  userRoles                 EventUserRoleEntity[]
  payoutDetails             OrganizerPayoutDetailsEntity?
  notifications             notifications[]
  ticketTiers               TicketTierEntity[]

  @@index([festivalId])
  @@index([ownerId])
  @@map("event")
  @@schema("oppskills")
}

/// Join table for event participants (individual user registration).
model EventParticipantEntity {
  id                                String                                   @id @default(cuid())
  eventId                           String                                   @map("event_id")
  userId                            String                                   @map("user_id")
  joinedAt                          DateTime                                 @default(now()) @map("joined_at")
  approved                          Boolean                                  @default(false)
  approvedAt                        DateTime?                                @map("approved_at")
  approvedById                      String?                                  @map("approved_by_id")
  passEmailSent                     Boolean                                  @default(false) @map("pass_email_sent")
  passEmailSentAt                   DateTime?                                @map("pass_email_sent_at")
  referralId                        String?                                  @map("referral_id")
  approvedBy                        UserEntity?                              @relation("EventParticipantApprover", fields: [approvedById], references: [id])
  event                             EventEntity                              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  referral                          ReferralEntity?                          @relation(fields: [referralId], references: [id])
  user                              UserEntity                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventPass                         EventPassEntity?
  payment                           EventPaymentEntity?
  submission                        EventRegistrationSubmissionEntity?
  incompleteRegistrationReminderLog IncompleteRegistrationReminderLogEntity?
  /// True while user saved registration answers but has not completed payment (paid events).
  /// Hidden from organizer lists until checkout completes.
  checkoutPending                   Boolean                                  @default(false) @map("checkout_pending")

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([referralId])
  @@map("event_participant")
  @@schema("oppskills")
}

model ReferralEntity {
  id                 String                   @id @default(cuid())
  code               String                   @unique
  entityType         ReferralEntityType       @map("entity_type")
  entityId           String                   @map("entity_id")
  referrerId         String                   @map("referrer_id")
  createdById        String                   @map("created_by_id")
  approvedById       String?                  @map("approved_by_id")
  isActive           Boolean                  @default(true) @map("is_active")
  isDeleted          Boolean                  @default(false) @map("is_deleted")
  deletedAt          DateTime?                @map("deleted_at")
  clicksCount        Int                      @default(0) @map("clicks_count")
  humanClicksCount   Int                      @default(0) @map("human_clicks_count")
  registrationsCount Int                      @default(0) @map("registrations_count")
  lastClickAt        DateTime?                @map("last_click_at")
  lastRegistrationAt DateTime?                @map("last_registration_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  eventParticipants  EventParticipantEntity[]
  approvedBy         UserEntity?              @relation("ReferralApprover", fields: [approvedById], references: [id])
  createdBy          UserEntity               @relation("ReferralCreator", fields: [createdById], references: [id], onDelete: Cascade)
  referrer           UserEntity               @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  clicks             ReferralClickEntity[]
  teams              TeamEntity[]
  teamMembers        TeamMemberEntity[]

  @@unique([entityType, entityId, referrerId])
  @@index([entityType, entityId])
  @@index([referrerId])
  @@index([createdById])
  @@map("referral")
  @@schema("oppskills")
}

model ReferralClickEntity {
  id            String         @id @default(cuid())
  referralId    String         @map("referral_id")
  ipHash        String         @map("ip_hash")
  userAgentHash String         @map("user_agent_hash")
  source        String?
  isBot         Boolean        @default(false) @map("is_bot")
  clickedAt     DateTime       @default(now()) @map("clicked_at")
  referral      ReferralEntity @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId, clickedAt])
  @@index([clickedAt])
  @@map("referral_click")
  @@schema("oppskills")
}

/// Event Pass entity - QR code-based pass for event participants.
model EventPassEntity {
  id            String                 @id @default(cuid())
  /// Display ticket ID (format: № 001429)
  ticketId      String                 @unique @map("ticket_id")
  /// Unique secure token for QR code validation (UUID v4)
  token         String                 @unique @default(uuid())
  /// User this pass belongs to
  userId        String                 @map("user_id")
  /// Event this pass is for
  eventId       String                 @map("event_id")
  /// Participant record (links to EventParticipantEntity)
  participantId String                 @unique @map("participant_id")
  /// Whether pass has been scanned/used
  isUsed        Boolean                @default(false) @map("is_used")
  /// When pass was scanned
  scannedAt     DateTime?              @map("scanned_at")
  /// Who scanned the pass (organizer/manager)
  scannedById   String?                @map("scanned_by_id")
  /// Pass creation and updates
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  event         EventEntity            @relation("EventPasses", fields: [eventId], references: [id], onDelete: Cascade)
  participant   EventParticipantEntity @relation(fields: [participantId], references: [id], onDelete: Cascade)
  scannedBy     UserEntity?            @relation("ScannedEventPasses", fields: [scannedById], references: [id])
  user          UserEntity             @relation("UserEventPasses", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([participantId])
  @@index([token])
  @@map("event_pass")
  @@schema("oppskills")
}

/// Join table for per-event user roles (Manager, Evaluator).
model EventUserRoleEntity {
  id          String        @id @default(cuid())
  eventId     String        @map("event_id")
  userId      String        @map("user_id")
  role        EventUserRole
  createdAt   DateTime      @default(now()) @map("created_at")
  createdById String?       @map("created_by_id")
  createdBy   UserEntity?   @relation("EventRoleCreator", fields: [createdById], references: [id])
  event       EventEntity   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        UserEntity    @relation("UserEventRoles", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, role])
  @@index([eventId])
  @@index([userId])
  @@map("event_user_role")
  @@schema("oppskills")
}

model RoundEntity {
  id               String                               @id @default(cuid())
  hackathonId      String                               @map("hackathon_id")
  name             String
  description      String?
  startsAt         DateTime                             @map("starts_at")
  endsAt           DateTime                             @map("ends_at")
  order            Int
  status           RoundStatus                          @default(UPCOMING)
  roundType        HackathonRoundType                   @map("round_type")
  submissionConfig Json?                                @map("submission_config")
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt
  teamSubmissions  HackathonTeamRoundSubmissionEntity[]
  hackathon        HackathonEntity                      @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  qualifications   TeamRoundQualificationEntity[]

  @@unique([hackathonId, order])
  @@index([hackathonId])
  @@map("round")
  @@schema("oppskills")
}

model RegistrationFormEntity {
  id               String                    @id @default(cuid())
  externalFormLink String?                   @map("external_form_link")
  hackathonId      String?                   @unique @map("hackathon_id")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  fields           RegistrationFieldEntity[]
  hackathon        HackathonEntity?          @relation(fields: [hackathonId], references: [id])

  @@map("registration_form")
  @@schema("oppskills")
}

model RegistrationFieldEntity {
  id                 String                              @id @default(cuid())
  registrationFormId String                              @map("registration_form_id")
  label              String
  type               RegistrationFieldType
  required           Boolean                             @default(false)
  order              Int
  options            String[]                            @default([])
  placeholder        String?
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  hackathonAnswers   HackathonRegistrationAnswerEntity[]
  registrationForm   RegistrationFormEntity              @relation(fields: [registrationFormId], references: [id])

  @@unique([registrationFormId, order])
  @@index([registrationFormId])
  @@map("registration_field")
  @@schema("oppskills")
}

model PrizeBreakdownEntity {
  id          String          @id @default(cuid())
  hackathonId String          @map("hackathon_id")
  position    String
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  hackathon   HackathonEntity @relation(fields: [hackathonId], references: [id])

  @@index([hackathonId])
  @@map("prize_breakdown")
  @@schema("oppskills")
}

model TeamEntity {
  id                      String                                  @id @default(cuid())
  name                    String
  createdAt               DateTime                                @default(now())
  updatedAt               DateTime                                @updatedAt
  maxSize                 Int
  hackathonId             String
  leaderId                String
  creatorId               String                                  @map("creator_id")
  /// Unique invitation code for joining this team (generated on create)
  invitationCode          String?                                 @unique @map("invitation_code")
  /// Whether the team is open for new members to browse and join
  isOpen                  Boolean                                 @default(true) @map("is_open")
  /// When set, the PER_TEAM leader registration was attributed to this referral (leader has no TeamMemberEntity row).
  referralId              String?                                 @map("referral_id")
  payments                HackathonPaymentEntity[]
  registrationSubmissions HackathonRegistrationSubmissionEntity[]
  roundSubmissions        HackathonTeamRoundSubmissionEntity[]
  creator                 UserEntity                              @relation("TeamCreator", fields: [creatorId], references: [id])
  hackathon               HackathonEntity                         @relation(fields: [hackathonId], references: [id])
  leader                  UserEntity                              @relation("UserTeams", fields: [leaderId], references: [id])
  referral                ReferralEntity?                         @relation(fields: [referralId], references: [id])
  members                 TeamMemberEntity[]
  roundQualifications     TeamRoundQualificationEntity[]

  @@index([referralId])
  @@map("team")
  @@schema("oppskills")
}

model TeamMemberEntity {
  id                     String                                 @id @default(cuid())
  joinedAt               DateTime                               @default(now())
  userId                 String
  teamId                 String
  referralId             String?                                @map("referral_id")
  scanned_at             DateTime?
  registrationSubmission HackathonRegistrationSubmissionEntity?
  referral               ReferralEntity?                        @relation(fields: [referralId], references: [id])
  team                   TeamEntity                             @relation(fields: [teamId], references: [id])
  user                   UserEntity                             @relation(fields: [userId], references: [id])

  @@unique([userId, teamId])
  @@index([referralId])
  @@map("team_member")
  @@schema("oppskills")
}

/// Registration submission for a hackathon (links user + team + hackathon).
/// Created when user creates or joins a team and fills registration form.
model HackathonRegistrationSubmissionEntity {
  id           String                              @id @default(cuid())
  hackathonId  String                              @map("hackathon_id")
  userId       String                              @map("user_id")
  teamId       String                              @map("team_id")
  /// Optional link to team member (null for team leader who is not in members table)
  teamMemberId String?                             @unique @map("team_member_id")
  /// Whether this user is the team leader
  isLeader     Boolean                             @default(false) @map("is_leader")
  submittedAt  DateTime                            @default(now()) @map("submitted_at")
  createdAt    DateTime                            @default(now())
