// Root Prisma schema — generator and datasource only.
// Domain models live in ./schemas/*.prisma (multi-file schema).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["admin", "user", "common", "events", "hackathon", "payments", "email_notifications"]
}
