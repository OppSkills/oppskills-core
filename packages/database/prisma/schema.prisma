  discountCode   EventDiscountCodeEntity @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  payment        EventPaymentEntity      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user           UserEntity              @relation("UserEventDiscountRedemptions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, userId])
  @@index([discountCodeId])
  @@index([userId])
  @@map("event_discount_redemption")
  @@schema("oppskills")
}

/// Record of a manual payout to an organizer for an event.
model EventPayoutEntity {
  id          String                  @id @default(cuid())
  eventId     String                  @map("event_id")
  organizerId String                  @map("organizer_id")
  amount      Decimal                 @db.Decimal(12, 2)
  currency    String                  @default("INR")
  status      PayoutStatus            @default(PAID)
  eligibleAt  DateTime                @map("eligible_at")
  paidAt      DateTime                @map("paid_at")
  reference   String
  notes       String?
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  event       EventEntity             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizer   UserEntity              @relation("UserEventPayoutsReceived", fields: [organizerId], references: [id])
  items       EventPayoutItemEntity[]

  @@index([eventId])
  @@index([organizerId])
  @@map("event_payout")
  @@schema("oppskills")
}

/// Links an event payout to the individual payments it covers.
model EventPayoutItemEntity {
  id              String             @id @default(cuid())
  payoutId        String             @map("payout_id")
  paymentId       String             @map("payment_id")
  amountAllocated Decimal            @map("amount_allocated") @db.Decimal(12, 2)
  createdAt       DateTime           @default(now()) @map("created_at")
  payment         EventPaymentEntity @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  payout          EventPayoutEntity  @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@unique([payoutId, paymentId])
  @@index([payoutId])
  @@index([paymentId])
  @@map("event_payout_item")
  @@schema("oppskills")
}

/// Ticket tier for events and hackathons (multi-pricing support).
model TicketTierEntity {
  id          String                   @id @default(cuid())
  name        String
  description String?
  price       Decimal                  @db.Decimal(12, 2)
  currency    String                   @default("INR")
  /// null = unlimited
  capacity    Int?
  isActive    Boolean                  @default(true) @map("is_active")
  /// Display order (lower = shown first)
  order       Int                      @default(0)
  eventId     String?                  @map("event_id")
  hackathonId String?                  @map("hackathon_id")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")
  event       EventEntity?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hackathon   HackathonEntity?         @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  eventPayments      EventPaymentEntity[]     @relation("EventPaymentTicketTier")
  hackathonPayments  HackathonPaymentEntity[] @relation("HackathonPaymentTicketTier")

  @@index([eventId])
  @@index([hackathonId])
  @@map("ticket_tier")
  @@schema("oppskills")
}

/// Tracks last send time for incomplete-registration reminder emails (per hackathon or event payment).
model IncompleteRegistrationReminderLogEntity {
  id                 String                  @id @default(cuid())
  hackathonPaymentId String?                 @unique @map("hackathon_payment_id")
  eventPaymentId     String?                 @unique @map("event_payment_id")
  lastSentAt         DateTime                @map("last_sent_at")
  sentCount          Int                     @default(1) @map("sent_count")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  /// Free event: participant row without a completed registration submission (no payment row).
  eventParticipantId String?                 @unique @map("event_participant_id")
  eventParticipant   EventParticipantEntity? @relation(fields: [eventParticipantId], references: [id], onDelete: Cascade)
  eventPayment       EventPaymentEntity?     @relation(fields: [eventPaymentId], references: [id], onDelete: Cascade)
  hackathonPayment   HackathonPaymentEntity? @relation(fields: [hackathonPaymentId], references: [id], onDelete: Cascade)

  @@index([lastSentAt])
  @@map("incomplete_registration_reminder_log")
  @@schema("oppskills")
}

/// Waitlist for upcoming features - users can sign up to be notified when features launch.
model FeatureWaitlistEntity {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  feature   String
  createdAt DateTime   @default(now()) @map("created_at")
  user      UserEntity @relation("UserFeatureWaitlist", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
  @@index([feature])
  @@map("feature_waitlist")
  @@schema("oppskills")
}

model AdminEntity {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  immutable    Boolean    @default(false)
  isFirstLogin Boolean    @default(true) @map("is_first_login")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  adminLogs    AdminLog[]

  @@index([id])
  @@index([email])
  @@map("admin_entity")
  @@schema("oppskills")
}

model AdminLog {
  id        String      @id @default(cuid())
  adminId   String      @map("admin_id")
  action    String
  type      String
  createdAt DateTime    @default(now()) @map("created_at")
  admin     AdminEntity @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([type])
  @@index([createdAt])
  @@map("admin_log")
  @@schema("oppskills")
}

model notifications {
  id String @id @default(cuid())

  userId      String  @map("user_id")
  eventId     String? @map("event_id")
  hackathonId String? @map("hackathon_id")

  content String

  // Scheduling
  scheduleType ScheduleType @default(IMMEDIATELY) @map("schedule_type")
  scheduledAt  DateTime?    @map("scheduled_at")

  // Status
  status NotificationStatus @default(DRAFT)

  // Progress tracking
  totalRecipients Int? @map("total_recipients")
  processedCount  Int  @default(0) @map("processed_count")
  successCount    Int  @default(0) @map("success_count")
  failedCount     Int  @default(0) @map("failed_count")

  // Cursor
  lastProcessedId String? @map("last_processed_id")

  // Worker control
  processingBy          String?   @map("processing_by")
  processingStartedAt   DateTime? @map("processing_started_at")
  processingHeartbeatAt DateTime? @map("processing_heartbeat_at")

  // Retry control
  retryCount Int @default(0) @map("retry_count")

  // Timing
  expectedFinishAt DateTime? @map("expected_finish_at")
  completedAt      DateTime? @map("completed_at")

  // Safety to avoid duplication of same notification
  dedupeKey String? @unique @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  user      UserEntity       @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  event     EventEntity?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hackathon HackathonEntity? @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  logs NotificationLogs[]

  @@index([userId])
  @@index([eventId])
  @@index([hackathonId])
  @@index([status])
  @@index([scheduledAt])
  @@map("notifications")
  @@schema("oppskills")
}

model NotificationLogs {
  id String @id @default(cuid())

  notificationId String @map("notification_id")

  level   LogLevel
  message String
  meta    Json?

  createdAt DateTime @default(now()) @map("created_at")

  notification notifications @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_logs")
  @@schema("oppskills")
}

