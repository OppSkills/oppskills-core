  CREATED
  PAID
  FAILED

  @@map("EventPaymentOrderStatus")
  @@schema("oppskills")
}

/// Payment record for event registration (individual participation).
model EventPaymentEntity {
  id          String      @id @default(cuid())
  eventId     String      @map("event_id")
  event       EventEntity @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizerId String      @map("organizer_id")
  organizer   UserEntity  @relation("EventPaymentOrganizer", fields: [organizerId], references: [id])
  payerUserId String      @map("payer_user_id")
  payerUser   UserEntity  @relation("EventPaymentPayer", fields: [payerUserId], references: [id])

  // Link to participant (created after payment verification)
  participantId String?                 @unique @map("participant_id")
  participant   EventParticipantEntity? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  // Money
  currency             String  @default("INR")
  grossAmount          Decimal @map("gross_amount") @db.Decimal(12, 2)
  platformFeeAmount    Decimal @map("platform_fee_amount") @db.Decimal(12, 2)
  organizerShareAmount Decimal @map("organizer_share_amount") @db.Decimal(12, 2)

  // Razorpay order/payment
  razorpayOrderId   String  @unique @map("razorpay_order_id")
  razorpayPaymentId String? @unique @map("razorpay_payment_id")
  razorpaySignature String? @map("razorpay_signature")

  // Razorpay transfer (Route)
  razorpayTransferId  String? @map("razorpay_transfer_id")
  transferOnHold      Boolean @default(true) @map("transfer_on_hold")
  transferOnHoldUntil Int?    @map("transfer_on_hold_until")
  transferStatus      String? @map("transfer_status")
  settlementStatus    String? @map("settlement_status")

  // Status
  orderStatus   EventPaymentOrderStatus @default(CREATED) @map("order_status")
  paymentStatus EventPaymentStatus      @default(CREATED) @map("payment_status")

  // Discount
  discountCodeId String?                  @map("discount_code_id")
  discountCode   EventDiscountCodeEntity? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  discountAmount Decimal?                 @map("discount_amount") @db.Decimal(12, 2)

  // Refund
  razorpayRefundId String?       @unique @map("razorpay_refund_id")
  refundStatus     RefundStatus? @map("refund_status")
  refundedAmount   Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  refundedAt       DateTime?     @map("refunded_at")

  // Timestamps
  capturedAt DateTime? @map("captured_at")
  failedAt   DateTime? @map("failed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Discount redemption link
  discountRedemption EventDiscountRedemptionEntity?

  // Payout items (which payouts include this payment)
  payoutItems EventPayoutItemEntity[]

  incompleteRegistrationReminder IncompleteRegistrationReminderLogEntity?

  @@index([eventId])
  @@index([organizerId])
  @@index([payerUserId])
  @@map("event_payment")
  @@schema("oppskills")
}

/// Discount code for an event (supports PERCENT and FIXED types).
model EventDiscountCodeEntity {
  id             String           @id @default(cuid())
  eventId        String           @map("event_id")
  event          EventEntity      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code           String
  type           DiscountCodeType
  value          Decimal          @db.Decimal(12, 2)
  active         Boolean          @default(true)
  maxRedemptions Int?             @map("max_redemptions")
  maxPerUser     Int              @default(1) @map("max_per_user")
  validFrom      DateTime?        @map("valid_from")
  validUntil     DateTime?        @map("valid_until")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  redemptions EventDiscountRedemptionEntity[]
  payments    EventPaymentEntity[]

  @@unique([eventId, code])
  @@index([eventId])
  @@map("event_discount_code")
  @@schema("oppskills")
}

/// Tracks redemption of an event discount code by a user.
model EventDiscountRedemptionEntity {
  id             String                  @id @default(cuid())
  discountCodeId String                  @map("discount_code_id")
  discountCode   EventDiscountCodeEntity @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  userId         String                  @map("user_id")
  user           UserEntity              @relation("UserEventDiscountRedemptions", fields: [userId], references: [id], onDelete: Cascade)
  paymentId      String                  @unique @map("payment_id")
  payment        EventPaymentEntity      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  redeemedAt     DateTime                @default(now()) @map("redeemed_at")

  @@unique([discountCodeId, userId])
  @@index([discountCodeId])
  @@index([userId])
  @@map("event_discount_redemption")
  @@schema("oppskills")
}

/// Record of a manual payout to an organizer for an event.
model EventPayoutEntity {
  id          String       @id @default(cuid())
  eventId     String       @map("event_id")
  event       EventEntity  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizerId String       @map("organizer_id")
  organizer   UserEntity   @relation("UserEventPayoutsReceived", fields: [organizerId], references: [id])
  amount      Decimal      @db.Decimal(12, 2)
  currency    String       @default("INR")
  status      PayoutStatus @default(PAID)
  eligibleAt  DateTime     @map("eligible_at")
  paidAt      DateTime     @map("paid_at")
  reference   String // UTR / bank transfer reference
  notes       String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Line items (which payments were covered)
  items EventPayoutItemEntity[]

  @@index([eventId])
  @@index([organizerId])
  @@map("event_payout")
  @@schema("oppskills")
}

/// Links an event payout to the individual payments it covers.
model EventPayoutItemEntity {
  id              String             @id @default(cuid())
  payoutId        String             @map("payout_id")
  payout          EventPayoutEntity  @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  paymentId       String             @map("payment_id")
  payment         EventPaymentEntity @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountAllocated Decimal            @map("amount_allocated") @db.Decimal(12, 2)
  createdAt       DateTime           @default(now()) @map("created_at")

  @@unique([payoutId, paymentId])
  @@index([payoutId])
  @@index([paymentId])
  @@map("event_payout_item")
  @@schema("oppskills")
}

/// Tracks last send time for incomplete-registration reminder emails (per hackathon or event payment).
model IncompleteRegistrationReminderLogEntity {
  id String @id @default(cuid())

  hackathonPaymentId String? @unique @map("hackathon_payment_id")
  hackathonPayment   HackathonPaymentEntity? @relation(fields: [hackathonPaymentId], references: [id], onDelete: Cascade)

  eventPaymentId String? @unique @map("event_payment_id")
  eventPayment   EventPaymentEntity? @relation(fields: [eventPaymentId], references: [id], onDelete: Cascade)

  lastSentAt DateTime @map("last_sent_at")
  sentCount  Int      @default(1) @map("sent_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lastSentAt])
  @@map("incomplete_registration_reminder_log")
  @@schema("oppskills")
}

/// Waitlist for upcoming features - users can sign up to be notified when features launch.
model FeatureWaitlistEntity {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  user      UserEntity @relation("UserFeatureWaitlist", fields: [userId], references: [id], onDelete: Cascade)
  feature   String // Feature identifier (e.g., "skill-based-learning-tracks", "mentor-led-sessions")
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([userId, feature])
  @@index([userId])
  @@index([feature])
  @@map("feature_waitlist")
  @@schema("oppskills")
}

model AdminEntity {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String
  immutable    Boolean    @default(false)
  isFirstLogin Boolean    @default(true) @map("is_first_login")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  adminLogs    AdminLog[]

  @@index([id])
  @@index([email])
  @@map("admin_entity")
  @@schema("oppskills")
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String   @map("admin_id")
  action    String
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  admin AdminEntity @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([type])
  @@index([createdAt])
  @@map("admin_log")
  @@schema("oppskills")
}
