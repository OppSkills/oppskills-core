
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Ignore this warning, it's not used in the schema file
  schemas  = ["oppskills"]
}

enum HackathonMode {
  ONLINE
  OFFLINE
  HYBRID

  @@map("HackathonMode")
  @@schema("oppskills")
}

model UserEntity {
  id         String   @id @default(cuid())
  email      String   @unique
  imageUrl   String?
  firstName  String?
  lastName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  hackathons   HackathonEntity[]   @relation("UserHackathons")  // created hackathons
  teams        TeamEntity[]        @relation("UserTeams")       // teams this user has created
  teamMembers  TeamMemberEntity[]                             // teams they are part of

  @@map("user")
  @@schema("oppskills")
}


model HackathonEntity {
  id          String         @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  mode        HackathonMode
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation: only the creator (organizer) can edit/delete
  ownerId     String
  owner       UserEntity   @relation("UserHackathons", fields: [ownerId], references: [id])

  // Relation: teams participating in this hackathon
  teams       TeamEntity[]

  @@map("hackathon")
  @@schema("oppskills")
}

model TeamEntity {
  id            String    @id @default(cuid())
  name          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  maxSize       Int       // decided by organizer when hackathon is created

  // Relations
  hackathonId   String
  hackathon     HackathonEntity  @relation(fields: [hackathonId], references: [id])

  leaderId      String
  leader        UserEntity       @relation("UserTeams", fields: [leaderId], references: [id])

  members       TeamMemberEntity[]

  @@map("team")
  @@schema("oppskills")
}


model TeamMemberEntity {
  id        String   @id @default(cuid())
  joinedAt  DateTime @default(now())

  // Relations
  userId    String
  user      UserEntity  @relation(fields: [userId], references: [id])

  teamId    String
  team      TeamEntity  @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])  // one user can't join the same team twice
  @@map("team_member")
  @@schema("oppskills")
}




