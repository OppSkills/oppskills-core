
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["oppskills"]
}

enum HackathonMode {
  ONLINE
  OFFLINE
  HYBRID

  @@map("HackathonMode")
  @@schema("oppskills")
}

/// Internal app authorization role for a user.
/// Default is USER.
enum AccessLevel {
  ADMIN
  USER
  VIEWER

  @@map("AccessLevel")
  @@schema("oppskills")
}

/// General lifecycle status for festivals and hackathons.
enum LifecycleStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED

  @@map("LifecycleStatus")
  @@schema("oppskills")
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNIVERSITY_ONLY

  @@map("Visibility")
  @@schema("oppskills")
}

enum HackathonType {
  CODING_HACKATHON
  IDEA_HACKATHON
  CASE_STUDY_COMPETITION
  DESIGN_HACKATHON
  OPEN_HACKATHON

  @@map("HackathonType")
  @@schema("oppskills")
}

enum ParticipantType {
  INDIVIDUAL
  TEAM_OF_2
  TEAM_OF_3
  TEAM_OF_4
  TEAM_OF_5
  TEAM_OF_6
  MORE_THAN_6

  @@map("ParticipantType")
  @@schema("oppskills")
}

enum LocationType {
  PHYSICAL
  VIRTUAL

  @@map("LocationType")
  @@schema("oppskills")
}

enum RoundStatus {
  UPCOMING
  ONGOING
  COMPLETED

  @@map("RoundStatus")
  @@schema("oppskills")
}

enum RegistrationFieldType {
  TEXT
  PHONE_NO
  EMAIL
  NUMBER
  ATTACHMENTS
  OPTIONS

  @@map("RegistrationFieldType")
  @@schema("oppskills")
}

/// Who can attend the hackathon (multi-select).
enum HackathonAttendeeEligibility {
  EVERYONE_CAN_APPLY
  SCHOOL_STUDENTS
  COLLEGE_STUDENTS
  FRESHERS
  PROFESSIONALS

  @@map("HackathonAttendeeEligibility")
  @@schema("oppskills")
}

/// Type of event.
enum EventType {
  WORKSHOP
  CONFERENCE
  MEETUP
  NETWORKING
  SEMINAR
  WEBINAR
  OTHER

  @@map("EventType")
  @@schema("oppskills")
}

/// Who can attend the event (multi-select).
enum EventAttendeeEligibility {
  EVERYONE_CAN_APPLY
  SCHOOL_STUDENTS
  COLLEGE_STUDENTS
  FRESHERS
  PROFESSIONALS

  @@map("EventAttendeeEligibility")
  @@schema("oppskills")
}

/// Type of hackathon round (determines submission requirements).
enum HackathonRoundType {
  ONLINE
  OFFLINE
  PRESENTATION

  @@map("HackathonRoundType")
  @@schema("oppskills")
}

/// Per-hackathon user roles (assigned by owner/admin).
enum HackathonUserRole {
  MANAGER
  EVALUATOR

  @@map("HackathonUserRole")
  @@schema("oppskills")
}

/// Per-event user roles (assigned by owner/admin).
enum EventUserRole {
  MANAGER
  EVALUATOR

  @@map("EventUserRole")
  @@schema("oppskills")
}

/// Gender values for onboarding profile.
enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY

  @@map("Gender")
  @@schema("oppskills")
}

/// User category for onboarding profile.
enum UserCategory {
  SCHOOL_STUDENT
  COLLEGE_STUDENT
  WORKING_PROFESSIONAL
  FRESHER
  PROFESSIONAL_SCHOOL_STUDENT

  @@map("UserCategory")
  @@schema("oppskills")
}

/// Experience level for onboarding profile.
enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@map("ExperienceLevel")
  @@schema("oppskills")
}

/// Team preference for onboarding profile.
enum TeamPreference {
  LOOKING_FOR_TEAM
  HAVE_TEAM
  OPEN_TO_EITHER
  PREFER_SOLO

  @@map("TeamPreference")
  @@schema("oppskills")
}

/// Approval status for platform-wide publish approval workflow.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("ApprovalStatus")
  @@schema("oppskills")
}

/// Join table for per-hackathon user roles (Manager, Evaluator).
model HackathonUserRoleEntity {
  id          String            @id @default(cuid())
  hackathonId String            @map("hackathon_id")
  hackathon   HackathonEntity   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  userId      String            @map("user_id")
  user        UserEntity        @relation("UserHackathonRoles", fields: [userId], references: [id], onDelete: Cascade)
  role        HackathonUserRole
  createdAt   DateTime          @default(now()) @map("created_at")
  createdById String?           @map("created_by_id")
  createdBy   UserEntity?       @relation("HackathonRoleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([hackathonId, userId, role])
  @@map("hackathon_user_role")
  @@schema("oppskills")
  @@index([hackathonId])
  @@index([userId])
}

model UserEntity {
  id         String   @id @default(cuid())
  email      String   @unique
  imageUrl   String?
  firstName  String?
  lastName   String?
  accessLevel AccessLevel @default(USER) @map("access_level")
  onboarded  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  hackathons   HackathonEntity[]   @relation("UserHackathons")  // created hackathons
  festivals    FestivalEntity[]    @relation("UserFestivals")   // created festivals
  teams        TeamEntity[]        @relation("UserTeams")       // teams this user has created
  teamMembers  TeamMemberEntity[]                             // teams they are part of

  // Per-hackathon roles (Manager/Evaluator)
  hackathonRoles        HackathonUserRoleEntity[] @relation("UserHackathonRoles")
  hackathonRolesCreated HackathonUserRoleEntity[] @relation("HackathonRoleCreator")

  // Event relations
  events               EventEntity[]           @relation("UserEvents")           // created events
  eventRoles           EventUserRoleEntity[]   @relation("UserEventRoles")       // event role assignments
  eventRolesCreated    EventUserRoleEntity[]   @relation("EventRoleCreator")     // event roles user assigned to others
  eventParticipations  EventParticipantEntity[]                                  // events user is participating in

  // Onboarding profile (1:1 relation)
  onboardingProfile UserOnboardingProfileEntity?

  @@map("user")
  @@schema("oppskills")
}


model HackathonEntity {
  id          String         @id @default(cuid())
  name        String         @map("title")
  description String?        @db.Text
  startDate   DateTime
  endDate     DateTime
  mode        HackathonMode
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---------------------------
  // Extended Hackathon Details
  // ---------------------------
  slug                     String          @unique
  festivalId               String?         @map("festival_id")
  festival                 FestivalEntity? @relation(fields: [festivalId], references: [id], onDelete: SetNull)
  bannerImageUrl           String?
  visibility               Visibility       @default(PUBLIC)
  hackathonType            HackathonType    @default(CODING_HACKATHON)
  participantType          ParticipantType  @default(INDIVIDUAL)

  // Location (denormalized columns for easy filtering)
  locationType             LocationType?    @map("location_type")
  locationAddress          String?          @map("location_address")
  locationCity             String?          @map("location_city")
  locationVirtualLink      String?          @map("location_virtual_link")

  // Registration
  registrationDeadline     DateTime?        @map("registration_deadline")
  externalRegistrationLink String?          @map("external_registration_link")
  registrationForm         RegistrationFormEntity?

  // Pricing & Prizes
  isFree                   Boolean          @default(true) @map("is_free")
  entryFeeAmount           Decimal?         @db.Decimal(12, 2) @map("entry_fee_amount")
  currency                 String           @default("INR")
  prizeTotalWorthAmount    Decimal?         @db.Decimal(12, 2) @map("prize_total_worth_amount")
  prizeBreakdown           PrizeBreakdownEntity[]
  prizeDescription         Json?            @map("prize_description")
  prizeCertificate         Boolean          @default(false) @map("prize_certificate")

  // Organizer / University Restrictions
  organizationName         String?          @map("organization_name")
  organizationLogoUrl      String?          @map("organization_logo_url")
  allowedUniversities      String[]         @default([]) @map("allowed_universities")

  // Eligibility & Team Settings
  attendeeEligibility      HackathonAttendeeEligibility[] @default([]) @map("attendee_eligibility")
  maxTeams                 Int?             @map("max_teams")

  // Additional Contact Info
  contactName              String?          @map("contact_name")
  contactEmail             String?          @map("contact_email")
  contactPhone             String?          @map("contact_phone")

  // Metadata
  impressions              Int              @default(0)
  registrationCount        Int              @default(0) @map("registration_count")
  status                   LifecycleStatus  @default(DRAFT)

  // Approval workflow fields
  approvalStatus           ApprovalStatus   @default(PENDING) @map("approval_status")
  approvalSubmittedAt      DateTime?        @map("approval_submitted_at")
  approvalApprovedAt       DateTime?        @map("approval_approved_at")
  approvalRejectedAt       DateTime?        @map("approval_rejected_at")
  approvalNote             String?          @map("approval_note") @db.Text

  // Relation: only the creator (organizer) can edit/delete
  ownerId     String
  owner       UserEntity   @relation("UserHackathons", fields: [ownerId], references: [id])

  // Relation: teams participating in this hackathon
  teams       TeamEntity[]

  // Relations: hackathon structure
  rounds      RoundEntity[]
  attachments HackathonAttachmentEntity[]

  // Per-hackathon user roles (Manager/Evaluator)
  userRoles   HackathonUserRoleEntity[]

  @@map("hackathon")
  @@schema("oppskills")
  @@index([festivalId])
}

model FestivalEntity {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  posterImageUrl String? @map("poster_image_url")
  websiteUrl  String?  @map("website_url")

  // Location
  locationType        LocationType? @map("location_type")
  locationAddress     String?       @map("location_address")
  locationCity        String?       @map("location_city")
  locationVirtualLink String?       @map("location_virtual_link")

  // Dates
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")

  // Organizer
  organizerId          String?     @map("organizer_id")
  organizer            UserEntity? @relation("UserFestivals", fields: [organizerId], references: [id], onDelete: SetNull)
  organizationName     String? @map("organization_name")
  organizationLogoUrl  String? @map("organization_logo_url")

  // Lifecycle
  status        LifecycleStatus @default(DRAFT)

  // Approval workflow fields
  approvalStatus           ApprovalStatus   @default(PENDING) @map("approval_status")
  approvalSubmittedAt      DateTime?        @map("approval_submitted_at")
  approvalApprovedAt       DateTime?        @map("approval_approved_at")
  approvalRejectedAt       DateTime?        @map("approval_rejected_at")
  approvalNote             String?          @map("approval_note") @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  hackathons HackathonEntity[]
  events     EventEntity[]

  @@map("festival")
  @@schema("oppskills")
  @@index([organizerId])
}

/// Event entity - simpler than Hackathon, for individual user participation.
model EventEntity {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  bannerImageUrl String? @map("banner_image_url")

  // Dates
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")

  // Festival link (optional - can be standalone)
  festivalId  String?         @map("festival_id")
  festival    FestivalEntity? @relation(fields: [festivalId], references: [id], onDelete: SetNull)

  // ---------------------------
  // Extended Event Details (matching Hackathon pattern)
  // ---------------------------
  visibility               Visibility       @default(PUBLIC)
  eventType                EventType        @default(CONFERENCE) @map("event_type")

  // Location (reuse existing pattern)
  locationType        LocationType? @map("location_type")
  locationAddress     String?       @map("location_address")
  locationCity        String?       @map("location_city")
  locationVirtualLink String?       @map("location_virtual_link")

  // Pricing (metadata only, no payment integration)
  isFree          Boolean  @default(true) @map("is_free")
  entryFeeAmount  Decimal? @db.Decimal(12, 2) @map("entry_fee_amount")
  currency        String   @default("INR")

  // Capacity
  maxUsers          Int? @map("max_users")
  registrationCount Int  @default(0) @map("registration_count")

  // Registration
  registrationDeadline     DateTime?        @map("registration_deadline")
  externalRegistrationLink String?          @map("external_registration_link")
  registrationForm         EventRegistrationFormEntity?

  // Eligibility
  attendeeEligibility      EventAttendeeEligibility[] @default([]) @map("attendee_eligibility")

  // Prizes
  prizeTotalWorthAmount    Decimal?         @db.Decimal(12, 2) @map("prize_total_worth_amount")
  prizeBreakdown           EventPrizeBreakdownEntity[]
  prizeDescription         Json?            @map("prize_description")
  prizeCertificate         Boolean          @default(false) @map("prize_certificate")

  // Contact Info
  contactName              String?          @map("contact_name")
  contactEmail             String?          @map("contact_email")
  contactPhone             String?          @map("contact_phone")

  // Lifecycle
  status LifecycleStatus @default(DRAFT)

  // Approval workflow fields
  approvalStatus           ApprovalStatus   @default(PENDING) @map("approval_status")
  approvalSubmittedAt      DateTime?        @map("approval_submitted_at")
  approvalApprovedAt       DateTime?        @map("approval_approved_at")
  approvalRejectedAt       DateTime?        @map("approval_rejected_at")
  approvalNote             String?          @map("approval_note") @db.Text

  // Registration controls
  isRegistrationPaused     Boolean          @default(false) @map("is_registration_paused")

  // Metadata
  impressions              Int              @default(0)

  // Ownership
  ownerId String     @map("owner_id")
  owner   UserEntity @relation("UserEvents", fields: [ownerId], references: [id])

  // Organizer info
  organizationName    String? @map("organization_name")
  organizationLogoUrl String? @map("organization_logo_url")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  participants EventParticipantEntity[]
  userRoles    EventUserRoleEntity[]
  attachments  EventAttachmentEntity[]

  @@map("event")
  @@schema("oppskills")
  @@index([festivalId])
  @@index([ownerId])
}

/// Join table for event participants (individual user registration).
model EventParticipantEntity {
  id       String   @id @default(cuid())
  eventId  String   @map("event_id")
  event    EventEntity @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id")
  user     UserEntity  @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([eventId, userId])
  @@map("event_participant")
  @@schema("oppskills")
  @@index([eventId])
  @@index([userId])
}

/// Join table for per-event user roles (Manager, Evaluator).
model EventUserRoleEntity {
  id        String        @id @default(cuid())
  eventId   String        @map("event_id")
  event     EventEntity   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String        @map("user_id")
  user      UserEntity    @relation("UserEventRoles", fields: [userId], references: [id], onDelete: Cascade)
  role      EventUserRole
  createdAt DateTime      @default(now()) @map("created_at")
  createdById String?     @map("created_by_id")
  createdBy   UserEntity? @relation("EventRoleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId, role])
  @@map("event_user_role")
  @@schema("oppskills")
  @@index([eventId])
  @@index([userId])
}

model RoundEntity {
  id          String      @id @default(cuid())
  hackathonId String      @map("hackathon_id")
  hackathon   HackathonEntity @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  name        String
  description String?     @db.Text

  // Use DateTime for real scheduling; API can expose "date" + "time" if desired.
  startsAt    DateTime    @map("starts_at")
  endsAt      DateTime    @map("ends_at")
  order       Int
  status      RoundStatus @default(UPCOMING)

  // Round type determines submission requirements
  roundType        HackathonRoundType @map("round_type")
  submissionConfig Json?              @map("submission_config")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("round")
  @@schema("oppskills")
  @@index([hackathonId])
  @@unique([hackathonId, order])
}

model RegistrationFormEntity {
  id               String   @id @default(cuid())
  externalFormLink String?  @map("external_form_link")

  // Hackathon registration form (optional; one per hackathon)
  hackathonId String? @unique @map("hackathon_id")
  hackathon   HackathonEntity? @relation(fields: [hackathonId], references: [id])

  fields    RegistrationFieldEntity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("registration_form")
  @@schema("oppskills")
}

model RegistrationFieldEntity {
  id                 String                @id @default(cuid())
  registrationFormId String                @map("registration_form_id")
  registrationForm   RegistrationFormEntity @relation(fields: [registrationFormId], references: [id])

  label       String
  type        RegistrationFieldType
  required    Boolean @default(false)
  order       Int
  options     String[] @default([])
  placeholder String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("registration_field")
  @@schema("oppskills")
  @@index([registrationFormId])
  @@unique([registrationFormId, order])
}

model PrizeBreakdownEntity {
  id          String   @id @default(cuid())
  hackathonId String   @map("hackathon_id")
  hackathon   HackathonEntity @relation(fields: [hackathonId], references: [id])

  position    String
  amount      Decimal  @db.Decimal(12, 2)
  description String?  @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prize_breakdown")
  @@schema("oppskills")
  @@index([hackathonId])
}

model TeamEntity {
  id            String    @id @default(cuid())
  name          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  maxSize       Int       // decided by organizer when hackathon is created

  // Relations
  hackathonId   String
  hackathon     HackathonEntity  @relation(fields: [hackathonId], references: [id])

  leaderId      String
  leader        UserEntity       @relation("UserTeams", fields: [leaderId], references: [id])

  members       TeamMemberEntity[]

  @@map("team")
  @@schema("oppskills")
}


model TeamMemberEntity {
  id        String   @id @default(cuid())
  joinedAt  DateTime @default(now())

  // Relations
  userId    String
  user      UserEntity  @relation(fields: [userId], references: [id])

  teamId    String
  team      TeamEntity  @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])  // one user can't join the same team twice
  @@map("team_member")
  @@schema("oppskills")
}

/// Attachments for hackathon (S3-ready: stores storageKey + optional publicUrl).
model HackathonAttachmentEntity {
  id           String   @id @default(cuid())
  hackathonId  String   @map("hackathon_id")
  hackathon    HackathonEntity @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  /// Storage key for S3 or other storage provider
  storageKey   String   @map("storage_key")

  /// Optional public URL (for direct access or CDN)
  publicUrl    String?  @map("public_url")

  /// Original file name
  fileName     String?  @map("file_name")

  /// MIME type of the file
  mimeType     String?  @map("mime_type")

  /// File size in bytes
  sizeBytes    Int?     @map("size_bytes")

  createdAt    DateTime @default(now())

  @@map("hackathon_attachment")
  @@schema("oppskills")
  @@index([hackathonId])
}

/// Registration form for events (separate from hackathon forms).
model EventRegistrationFormEntity {
  id               String   @id @default(cuid())
  externalFormLink String?  @map("external_form_link")

  // Event registration form (optional; one per event)
  eventId String? @unique @map("event_id")
  event   EventEntity? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  fields    EventRegistrationFieldEntity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_registration_form")
  @@schema("oppskills")
}

/// Registration field for event forms.
model EventRegistrationFieldEntity {
  id                 String                     @id @default(cuid())
  registrationFormId String                     @map("registration_form_id")
  registrationForm   EventRegistrationFormEntity @relation(fields: [registrationFormId], references: [id], onDelete: Cascade)

  label       String
  type        RegistrationFieldType
  required    Boolean @default(false)
  order       Int
  options     String[] @default([])
  placeholder String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("event_registration_field")
  @@schema("oppskills")
  @@index([registrationFormId])
  @@unique([registrationFormId, order])
}

/// Prize breakdown for events.
model EventPrizeBreakdownEntity {
  id          String      @id @default(cuid())
  eventId     String      @map("event_id")
  event       EventEntity @relation(fields: [eventId], references: [id], onDelete: Cascade)

  position    String
  amount      Decimal     @db.Decimal(12, 2)
  description String?     @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("event_prize_breakdown")
  @@schema("oppskills")
  @@index([eventId])
}

/// Attachments for events (S3-ready: stores storageKey + optional publicUrl).
model EventAttachmentEntity {
  id           String      @id @default(cuid())
  eventId      String      @map("event_id")
  event        EventEntity @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Storage key for S3 or other storage provider
  storageKey   String   @map("storage_key")

  /// Optional public URL (for direct access or CDN)
  publicUrl    String?  @map("public_url")

  /// Original file name
  fileName     String?  @map("file_name")

  /// MIME type of the file
  mimeType     String?  @map("mime_type")

  /// File size in bytes
  sizeBytes    Int?     @map("size_bytes")

  createdAt    DateTime @default(now())

  @@map("event_attachment")
  @@schema("oppskills")
  @@index([eventId])
}

/// College entity for storing colleges in the system.
model CollegeEntity {
  id       String  @id
  name     String
  country  String
  state    String
  city     String
  address  String
  website  String?
  logo     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Users who selected this college
  onboardingProfiles UserOnboardingProfileEntity[]

  @@map("college")
  @@schema("oppskills")
  @@index([name])
  @@index([city])
  @@index([state])
}

/// User onboarding profile entity (1:1 with UserEntity).
model UserOnboardingProfileEntity {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   UserEntity @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 1: Primary Identity
  gender       Gender
  userCategory UserCategory @map("user_category")

  // Step 2: Education/Work Details
  // School fields (for SCHOOL_STUDENT)
  schoolName    String? @map("school_name")
  schoolClass   String? @map("school_class")
  schoolAddress String? @map("school_address")

  // College fields (for COLLEGE_STUDENT, PROFESSIONAL_SCHOOL_STUDENT)
  collegeId          String?        @map("college_id")
  college            CollegeEntity? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  collegeCurrentYear String?        @map("college_current_year")
  collegePassoutYear Int?           @map("college_passout_year")
  collegeSkipped     Boolean        @default(false) @map("college_skipped")

  // Working professional fields
  companyName  String? @map("company_name")
  jobTitle     String? @map("job_title")

  // Step 3: Location
  locationCity    String  @map("location_city")
  locationState   String  @map("location_state")
  locationCountry String  @map("location_country")

  // Step 4: Interests and Skills
  interests String[] @default([])
  skills    String[] @default([])

  // Step 5: Experience Level (optional)
  experienceLevel ExperienceLevel? @map("experience_level")

  // Step 6: Team Preference (optional)
  teamPreference TeamPreference? @map("team_preference")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_onboarding_profile")
  @@schema("oppskills")
}
