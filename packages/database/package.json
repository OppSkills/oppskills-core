{
  "name": "@oppskills/db",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm run generate && tsc",
    "dev": "prisma studio --port 3008",
    "start": "prisma migrate deploy",
    "generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev && prisma migrate deploy"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.18.0",
    "typescript": "^5.1.3"
  }
}
