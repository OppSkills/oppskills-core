# syntax=docker/dockerfile:1.7

##
# Production Docker image for OppSkills backend (NestJS) in this monorepo.
#
# Build context: repository root
# Build command example:
#   docker build -f apps/backend/Dockerfile.prod -t oppskills-backend:local .
#
# Runtime:
# - Starts via `apps/backend/docker-entrypoint.sh`
# - Loads secrets from AWS Secrets Manager at boot (EC2/ECS role)
# - Optionally runs Prisma migrations
##

FROM node:22-alpine AS base

WORKDIR /app

# Needed by some native deps; also helps Prisma on Alpine.
RUN apk add --no-cache libc6-compat openssl

# Ensure pnpm is available at runtime (no network fetch during container boot).
# Repo pins pnpm in `package.json` as `pnpm@10.5.2`.
RUN corepack enable && corepack prepare pnpm@10.5.2 --activate

FROM base AS deps

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/emails/package.json packages/emails/package.json

RUN pnpm install --frozen-lockfile

FROM deps AS build

# Copy the full repo after deps are installed for better layer caching.
COPY . .

# Build backend + its workspace deps (db/types) via turbo.
RUN pnpm build:backend

FROM base AS runner

ENV NODE_ENV="production"
ENV PORT="3001"

# Copy built app + node_modules from build stage
COPY --from=build /app /app

# Ensure entrypoint is executable
RUN chmod +x /app/apps/backend/docker-entrypoint.sh

EXPOSE 3001

ENTRYPOINT ["/app/apps/backend/docker-entrypoint.sh"]


