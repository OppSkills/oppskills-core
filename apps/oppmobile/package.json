{
  "name": "oppmobile",
  "version": "1.0.0",
  "main": "App.tsx",
  "scripts": {
    "start": "cross-env EXPO_OFFLINE=1 expo start --lan",
    "start:tunnel": "cross-env EXPO_OFFLINE=1 expo start --tunnel",
    "start:clear": "cross-env EXPO_OFFLINE=1 expo start --lan --clear",
    "android": "cross-env EXPO_OFFLINE=1 expo run:android",
    "android:device": "cross-env EXPO_OFFLINE=1 expo run:android --device",
    "ios": "expo run:ios",
    "web": "expo start --web --offline",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2",
    "@expo/metro-runtime": "6.1.2",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@tanstack/react-query": "^5.90.5",
    "boneyard-js": "^1.8.1",
    "expo": "54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-modules-core": "^3.0.30",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "hoist-non-react-statics": "^3.3.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "zod": "3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
